# ---------------------------------------------------------------------------
# Copy to .env and fill in. With no SUPABASE_URL the site runs off a local
# file (.data/db.json) so everything works before the project exists.
# ---------------------------------------------------------------------------

# --- Supabase (Project settings → API) -------------------------------------
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...            # needed for admin sign-in
# SUPABASE_SERVICE_ROLE_KEY=eyJ...    # server only — never expose to the browser

# --- Admin sign-in ----------------------------------------------------------
# With Supabase, the password is checked by Supabase Auth and these two are
# ignored. Without it, they are the panel's credentials.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=rabotilnitsa

# Signs the admin session cookie. Required in production.
#   openssl rand -hex 32
ADMIN_SESSION_SECRET=change-me

# --- Email (optional; bookings work without it) ----------------------------
# RESEND_API_KEY=re_...
# MAIL_FROM="Работилница <zdravey@mail.edinpodarak.com>"
# OWNER_EMAIL=djeilqart@gmail.com
