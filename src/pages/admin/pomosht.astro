---
import Admin from '../../layouts/Admin.astro';
import { readSession, revokeOtherSessions, recentSessions } from '../../lib/auth';
import { brand } from '../../data/site';

export const prerender = false;

// One round trip: the session is looked up and marked as used at once.
const session = await readSession(Astro.cookies);
if (!session) return Astro.redirect('/admin/vhod', 302);

/**
 * „Влизания в панела“.
 *
 * The password is shared and has travelled by message, which makes one
 * question worth being able to answer without asking anybody: has somebody
 * else been in here? Every sign-in is a row, and she can end all of them but
 * her own with one button - which is also what to press the day the password
 * changes.
 */
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('action') ?? '') === 'revoke') {
    const n = await revokeOtherSessions(session);
    return Astro.redirect(`/admin/pomosht?izlezli=${n}#vlizaniya`, 302);
  }
}

const revoked = Astro.url.searchParams.get('izlezli');
const sessions = await recentSessions(session.email);

const when = (iso: string) =>
  new Intl.DateTimeFormat('bg-BG', {
    day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit',
    timeZone: 'Europe/Sofia',
  }).format(new Date(iso));

/** „iPhone · Safari“ - enough for her to recognise her own telephone. */
function device(ua: string): string {
  if (!ua) return 'Неизвестно устройство';
  const os = /iPhone|iPad/.test(ua) ? 'iPhone'
    : /Android/.test(ua) ? 'Android'
    : /Mac OS X/.test(ua) ? 'Mac'
    : /Windows/.test(ua) ? 'Windows'
    : /Linux/.test(ua) ? 'Linux' : 'Устройство';
  const browser = /Edg\//.test(ua) ? 'Edge'
    : /OPR\//.test(ua) ? 'Opera'
    : /Chrome\//.test(ua) ? 'Chrome'
    : /Firefox\//.test(ua) ? 'Firefox'
    : /Safari\//.test(ua) ? 'Safari' : 'браузър';
  return `${os} · ${browser}`;
}

const live = (r: { revoked_at: string | null; expires_at: string }) =>
  !r.revoked_at && new Date(r.expires_at) > new Date();
---

<Admin title="Помощ" email={session.email}>
  <div class="pagehead">
    <div>
      <h1>Как се работи с панела</h1>
      <p class="sub">Всичко, което ти трябва, на една страница. Няма как да счупиш нещо.</p>
    </div>
  </div>

  <section class="card help">
    <h2>Да обявиш нова работилница</h2>
    <ol>
      <li><b>Работилници</b> → <b>+ Нова работилница</b>.</li>
      <li>
        Попълваш заглавие, дата и час, място, цена и брой места. Само тези са
        задължителни - останалото може и по-късно.
      </li>
      <li>
        <b>Снимка:</b> избираш файл от телефона и той се качва сам. Хубаво е да е
        снимка на творба от същия вид работилница.
      </li>
      <li>
        <b>Статус:</b> докато е <i>Чернова</i>, никой не я вижда. Щом сложиш
        <i>Публикувана</i> и запазиш, тя се появява на сайта веднага.
      </li>
    </ol>
    <p class="tip">
      Правиш същата работилница на нова дата? Отваряш старата и натискаш
      <b>Повтори на друга дата</b> - прави копие с празна дата, за да не
      попълваш всичко отново.
    </p>
  </section>

  <section class="card help">
    <h2>Да видиш кой се е записал</h2>
    <ol>
      <li>При всяка работилница има бутон <b>Записани</b>.</li>
      <li>
        Виждаш име, телефон и имейл. Телефонът се набира с едно докосване от
        телефона ти.
      </li>
      <li>
        След работилницата маркирай кой е дошъл с <b>Дойде</b>. Ако някой се
        откаже - <b>Отказа</b>, и мястото веднага се освобождава за следващия
        от чакащите.
      </li>
      <li>
        <b>Свали списък (CSV)</b> ти дава файл, който се отваря в Excel - удобно
        е да го носиш на работилницата.
      </li>
    </ol>
    <p class="tip">
      Хората могат и сами да се отпишат от линка в имейла си. Мястото се
      освобождава автоматично и ти не правиш нищо.
    </p>
  </section>

  <section class="card help">
    <h2>Някой ти е писал или се е обадил</h2>
    <p>
      Не всички минават през сайта. Който ти пише в Instagram или те звъне, го
      добавяш сама - иначе сайтът показва свободни места, които всъщност ги
      няма.
    </p>
    <ol>
      <li>Влизаш в <b>Записани</b> при съответната работилница.</li>
      <li>Отваряш <b>+ Добави човек на ръка</b>.</li>
      <li>
        Име е задължително. Телефон и имейл - само ако ги имаш; ако човекът ти
        е писал в Instagram и нямаш нито едното, просто ги оставяш празни.
      </li>
      <li>
        Натискаш <b>Добави</b>. Мястото се заема веднага и на сайта, така че
        никой друг не може да го вземе.
      </li>
    </ol>
    <p class="tip">
      На такъв човек <b>не пращам имейл</b> - ти вече си говорила с него. В
      списъка тези редове са отбелязани с <b>на ръка</b>, за да знаеш кои са
      дошли от сайта и кои са твои. Ако местата вече са свършили, човекът
      влиза при чакащите.
    </p>
  </section>

  <section class="card help">
    <h2>Местата и листът на чакащите</h2>
    <p>
      Сайтът брои местата вместо теб. Когато свършат, формата не приема повече
      записвания, а предлага <b>лист на чакащите</b>. Освободи ли се място,
      първият от чакащите заема неговото място по ред на записване.
    </p>
    <p>
      Ако искаш да спреш записването за някоя дата, без да я скриваш: отваряш я
      и махаш отметката <b>Записването е отворено</b>.
    </p>
    <p>
      Всяка работилница има и <b>минимум хора</b> - по подразбиране 3. Той не
      спира никого да се запише; служи ти за поглед. В списъка с работилниците
      и над записаните пише колко души не достигат, а на сайта пише
      „Работилницата тръгва при 3 записани“, за да не разбере човек по
      телефона два дни по-рано, че датата се мести. Смениш ли го, го сменяш от
      <b>Промени работилницата → Места и цена</b>.
    </p>
  </section>

  <section class="card help">
    <h2>Въпроси и отзиви</h2>
    <p>
      В <b>Съдържание</b> се променят въпросите с отговорите и отзивите на
      хората. Каквото напишеш там, се появява на сайта веднага.
    </p>
    <p class="warn">
      Отзивите в момента са примерни - сложени са, за да се види как изглежда
      секцията. Замени ги с истински, преди сайтът да тръгне.
    </p>
  </section>

  <section class="card help" id="vlizaniya">
    <h2>Влизания в панела</h2>
    <p>
      Всяко влизане с твоята парола се записва тук. Ако видиш влизане, което
      не е твое - смени паролата и натисни бутона отдолу.
    </p>

    {revoked && (
      <p class="tip">
        {revoked === '0'
          ? 'Нямаше други влизания освен това.'
          : `Готово. Излязох от ${revoked} ${revoked === '1' ? 'друго място' : 'други места'}.`}
      </p>
    )}

    {sessions.length === 0 ? (
      <p>Още няма записани влизания.</p>
    ) : (
      <ul class="sess">
        {sessions.map((r) => (
          <li class={`sess__row${r.id === session.id ? ' is-me' : ''}`}>
            <span class="sess__dev">{device(r.user_agent)}</span>
            <span class="sess__meta">
              {when(r.created_at)}
              {r.ip ? ` · ${r.ip}` : ''}
            </span>
            <span class="sess__state">
              {r.id === session.id ? 'това си ти'
                : r.revoked_at ? 'излязло'
                : live(r) ? 'още е отворено' : 'изтекло'}
            </span>
          </li>
        ))}
      </ul>
    )}

    <form method="POST" class="sess__form">
      <input type="hidden" name="action" value="revoke" />
      <button class="btn btn--ghost" type="submit">Излез от всички други устройства</button>
    </form>
    <p class="tip">
      Влизането важи 12 часа, след което панелът пита за паролата пак.
      Паролата се сменя от Supabase → Authentication → Users.
    </p>
  </section>

  <section class="card help">
    <h2>Ако нещо се обърка</h2>
    <p>
      Нищо от панела не е окончателно освен изтриването на работилница - то
      маха и записаните за нея. Всичко останало може да се върне.
    </p>
    <p>
      Пиши на Alesse Studio и ще го оправим:
      <a class="link" href="https://alessestudio.com">alessestudio.com</a>.
    </p>
  </section>
</Admin>

<style>
  .help { margin-bottom: 1.25rem; }
  .help h2 { font-size: 1.15rem; margin-bottom: 0.75rem; }
  .help ol { margin: 0 0 0.9rem 1.1rem; display: grid; gap: 0.5rem; }
  .help p { margin: 0 0 0.7rem; color: var(--muted); max-width: 62ch; }
  .help li { max-width: 60ch; }
  .tip, .warn {
    margin-top: 0.9rem !important;
    padding: 0.75rem 0.9rem;
    border-radius: 6px;
    background: #F5F1E6;
    color: var(--ink) !important;
  }
  .warn { background: #FBF3DE; }

  .sess { list-style: none; margin: 0 0 1rem; padding: 0; display: grid; gap: 0.5rem; }
  .sess__row {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.1rem 0.8rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    font-size: 0.9rem;
  }
  /* `.help li` caps body text at 60ch and outranks a bare class; these are
     rows, not prose, so they take the width of the card. */
  .help .sess__row { max-width: none; }
  .sess__row.is-me { border-color: #BBD3B4; background: #F4F8F2; }
  .sess__dev { grid-column: 1; font-weight: 600; }
  .sess__meta { grid-column: 1; color: var(--muted); font-size: 0.82rem; }
  .sess__state {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    color: var(--muted);
    font-size: 0.82rem;
  }
  @media (max-width: 520px) {
    .sess__row { grid-template-columns: 1fr; }
    .sess__state { grid-column: 1; grid-row: auto; }
  }
  .sess__form { margin-bottom: 0.9rem; }
</style>
