---
import Admin from '../../../layouts/Admin.astro';
import { readSession } from '../../../lib/auth';
import { db, DbError, type RegistrationStatus } from '../../../lib/db';
import { fmtDateFull, fmtTime, availability, minimum } from '../../../lib/format';

export const prerender = false;

// One round trip: the session is looked up and marked as used at once.
const session = await readSession(Astro.cookies);
if (!session) return Astro.redirect('/admin/vhod', 302);

const { id } = Astro.params;
const event = await db.adminGetEvent(id!);
if (!event) return Astro.redirect('/admin', 302);

let addError = '';
let added = Astro.url.searchParams.get('dobaven');

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  // Most of her places still get taken by phone or on Instagram. Without
  // somewhere to put those people the site showed eight free seats for a
  // workshop that was nearly full, and the list she takes to the table was
  // missing half the names.
  if (form.get('action') === 'add') {
    const name = String(form.get('full_name') ?? '').trim();
    const people = Number(form.get('people_count') ?? 1);
    if (name.length < 2) {
      addError = 'Напиши името - поне две букви.';
    } else if (!Number.isInteger(people) || people < 1 || people > 10) {
      addError = 'Броят места трябва да е между 1 и 10.';
    } else {
      try {
        const res = await db.adminAddRegistration({
          event_id: id!,
          full_name: name,
          email: String(form.get('email') ?? '').trim() || null,
          phone: String(form.get('phone') ?? '').trim() || null,
          people_count: people,
          note: String(form.get('note') ?? '').trim() || null,
        });
        return Astro.redirect(`/admin/zapisvaniya/${id}?dobaven=${res.status}`, 302);
      } catch (e) {
        addError = e instanceof DbError && e.code === 'invalid_people_count'
          ? 'Броят места трябва да е между 1 и 10.'
          : 'Не успях да го запиша. Пробвай пак.';
      }
    }
  } else {
    const regId = String(form.get('reg_id') ?? '');
    const status = String(form.get('status') ?? '') as RegistrationStatus;
    if (regId && ['confirmed', 'waitlist', 'cancelled', 'attended'].includes(status)) {
      await db.adminSetRegistrationStatus(regId, status);
    }
    return Astro.redirect(`/admin/zapisvaniya/${id}`, 302);
  }
}

const rows = await db.adminListRegistrations(id!);

// The list she takes to the venue.
if (Astro.url.searchParams.get('csv') === '1') {
  const esc = (v: unknown) => `"${String(v ?? '').replace(/"/g, '""')}"`;
  const head = ['Име', 'Телефон', 'Имейл', 'Места', 'Статус', 'Бележка', 'Записан на', 'Откъде'];
  const label: Record<string, string> = {
    confirmed: 'Потвърдено', waitlist: 'Чакащ', cancelled: 'Отказано', attended: 'Присъствал',
  };
  const body = rows.map((r) => [
    r.full_name, r.phone, r.email, r.people_count,
    label[r.status] ?? r.status, r.note ?? '',
    new Date(r.created_at).toLocaleString('bg-BG', { timeZone: 'Europe/Sofia' }),
    r.source === 'manual' ? 'на ръка' : 'от сайта',
  ].map(esc).join(','));

  // BOM so Excel opens the Cyrillic correctly
  return new Response('﻿' + [head.map(esc).join(','), ...body].join('\r\n'), {
    headers: {
      'Content-Type': 'text/csv; charset=utf-8',
      'Content-Disposition': `attachment; filename="zapisvaniya-${event.slug}.csv"`,
    },
  });
}

const a = availability(event.capacity, event.seats_taken, event.registrations_open);
const m = minimum(event.seats_taken, event.min_participants);
const groups = {
  confirmed: rows.filter((r) => r.status === 'confirmed'),
  waitlist: rows.filter((r) => r.status === 'waitlist'),
  attended: rows.filter((r) => r.status === 'attended'),
  cancelled: rows.filter((r) => r.status === 'cancelled'),
};
const sections: { key: keyof typeof groups; title: string; hint: string }[] = [
  { key: 'confirmed', title: 'Записани', hint: 'Тези хора ги очакваш.' },
  { key: 'waitlist', title: 'Чакащи', hint: 'Ако някой се откаже, мястото отива при първия.' },
  { key: 'attended', title: 'Присъствали', hint: '' },
  { key: 'cancelled', title: 'Отказали се', hint: '' },
];
---

<Admin title={`Записани · ${event.title}`} email={session.email}>
  <div class="pagehead">
    <div>
      <h1>{event.title}</h1>
      <p class="sub">
        {fmtDateFull(event.starts_at)}, {fmtTime(event.starts_at)} ч. ·
        <strong>{event.seats_taken} от {event.capacity}</strong> места · {a.label}
      </p>
      {/* „3 / 8“ does not tell her whether the date is happening. This does. */}
      <p class={`minline${m.reached ? ' is-ok' : ''}`}>
        {m.reached
          ? `Минимумът от ${event.min_participants} души е събран - работилницата се провежда.`
          : event.seats_taken === 0
            ? `Още никой не се е записал. Работилницата се провежда при поне ${event.min_participants} души.`
            : m.needed === 1
              ? `Още един човек до минимума от ${event.min_participants}. Под него работилницата не се провежда.`
              : `Още ${m.needed} души до минимума от ${event.min_participants}. Под него работилницата не се провежда.`}
      </p>
    </div>
    <div class="head-actions">
      <a class="btn btn--ghost" href={`/admin/zapisvaniya/${id}?csv=1`}>Свали списъка (CSV)</a>
      <a class="btn btn--ghost" href={`/admin/rabotilnitsa/${id}`}>Промени работилницата</a>
    </div>
  </div>

  {added && (
    <p class="flash">
      {added === 'waitlist'
        ? 'Записах го при чакащите - местата вече са пълни.'
        : 'Записах го. Мястото е заето и на сайта.'}
    </p>
  )}

  <details class="card add" open={Boolean(addError)}>
    <summary class="add__summary">
      <span>+ Добави човек на ръка</span>
      <span class="sub">За тези, които са ти писали или се обадили</span>
    </summary>
    <form method="POST" class="add__form">
      <input type="hidden" name="action" value="add" />
      <label class="fld fld--wide">
        <span>Име <i>*</i></span>
        <input name="full_name" required minlength="2" placeholder="Мария Петрова" />
      </label>
      <label class="fld">
        <span>Телефон</span>
        <input name="phone" inputmode="tel" placeholder="0888 123 456" />
      </label>
      <label class="fld">
        <span>Имейл</span>
        <input name="email" type="email" placeholder="по желание" />
      </label>
      <label class="fld fld--narrow">
        <span>Места</span>
        <input name="people_count" type="number" min="1" max="10" value="1" />
      </label>
      <label class="fld fld--wide">
        <span>Бележка</span>
        <input name="note" placeholder="напр. плаща на място, идва с приятелка" />
      </label>
      <div class="add__foot">
        <button class="btn" type="submit">Добави</button>
        <p class="sub">
          Не му пращам имейл - ти вече си говорила с него. Ако местата свършат,
          отива при чакащите.
        </p>
      </div>
      {addError && <p class="add__err">{addError}</p>}
    </form>
  </details>

  {rows.length === 0 && (
    <div class="card empty">
      <h2>Още никой не се е записал.</h2>
      <p class="sub">Щом някой се запише, ще се появи тук.</p>
    </div>
  )}

  {sections.map(({ key, title, hint }) => groups[key].length > 0 && (
    <section class="card group">
      <header class="group__head">
        <h2 class="group__title">{title} <span class="count">{groups[key].length}</span></h2>
        {hint && <p class="sub">{hint}</p>}
      </header>
      <table>
        <thead>
          <tr><th>Име</th><th>Връзка</th><th>Места</th><th>Бележка</th><th></th></tr>
        </thead>
        <tbody>
          {groups[key].map((r) => (
            <tr>
              <td>
                <strong>{r.full_name}</strong>
                {r.source === 'manual' && <span class="by-hand">на ръка</span>}
                <span class="meta">{new Date(r.created_at).toLocaleDateString('bg-BG', { timeZone: 'Europe/Sofia' })}</span>
              </td>
              <td>
                {r.phone
                  ? <a href={`tel:${r.phone}`}>{r.phone}</a>
                  : <span class="meta">-</span>}
                {r.email && <span class="meta"><a href={`mailto:${r.email}`}>{r.email}</a></span>}
              </td>
              <td>{r.people_count}</td>
              <td class="note-cell">{r.note}</td>
              <td class="right">
                <form method="POST" class="inline">
                  <input type="hidden" name="reg_id" value={r.id} />
                  {key !== 'confirmed' && (
                    <button class="btn btn--ghost btn--sm" name="status" value="confirmed">Потвърди</button>
                  )}
                  {key === 'confirmed' && (
                    <button class="btn btn--ghost btn--sm" name="status" value="attended">Дойде</button>
                  )}
                  {key !== 'cancelled' && (
                    <button class="btn btn--danger btn--sm" name="status" value="cancelled">Отказа се</button>
                  )}
                </form>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </section>
  ))}

  <style>
    /* --- is this date happening? --- */
    .minline {
      margin: 0.5rem 0 0;
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--clay);
    }
    .minline.is-ok { color: var(--moss); font-weight: 500; }

    /* --- adding somebody she booked herself --- */
    .flash {
      margin: 0 0 1.2rem;
      padding: 0.85rem 1.1rem;
      border-radius: 6px;
      background: color-mix(in oklab, var(--moss) 14%, transparent);
      border: 1px solid color-mix(in oklab, var(--moss) 35%, transparent);
      font-size: 0.9rem;
    }
    .add { margin-bottom: 1.4rem; padding: 0; }
    .add__summary {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 0.2rem 0.9rem;
      padding: 1rem 1.2rem;
      cursor: pointer;
      font-weight: 600;
      list-style: none;
    }
    .add__summary::-webkit-details-marker { display: none; }
    .add__summary:hover { color: var(--moss); }
    .add[open] .add__summary { border-bottom: 1px solid var(--rule-soft); }

    .add__form {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
      gap: 0.9rem 1rem;
      padding: 1.2rem;
    }
    .fld { display: grid; gap: 0.3rem; min-width: 0; }
    .fld--wide { grid-column: 1 / -1; }
    .fld--narrow { max-width: 7rem; }
    .fld > span { font-size: 0.78rem; font-weight: 600; color: var(--muted); }
    .fld i { color: var(--clay-ink); font-style: normal; }
    .fld input {
      padding: 0.62rem 0.75rem;
      border: 1px solid var(--rule);
      border-radius: 5px;
      background: var(--paper);
      font: inherit;
      font-size: 0.95rem;
      min-width: 0;
    }
    .fld input:focus-visible { outline: 2px solid var(--moss); outline-offset: 1px; }
    /* She fills this in on her phone, standing in the shop. */
    @media (pointer: coarse) {
      .fld input { padding-block: 0.8rem; font-size: 1rem; }
      .add__summary { padding-block: 1.15rem; }
    }

    .add__foot {
      grid-column: 1 / -1;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.6rem 1rem;
    }
    .add__foot .sub { margin: 0; max-width: 44ch; }
    .add__err {
      grid-column: 1 / -1;
      margin: 0;
      color: var(--clay-ink);
      font-weight: 600;
      font-size: 0.9rem;
    }

    /* she needs to see at a glance which names the site brought her */
    .by-hand {
      display: inline-block;
      margin-left: 0.45rem;
      padding: 0.1em 0.5em;
      border-radius: 999px;
      background: color-mix(in oklab, var(--brass) 20%, transparent);
      color: #6B5520;
      font-size: 0.68rem;
      font-weight: 700;
      letter-spacing: 0.03em;
      vertical-align: 0.12em;
    }

    .head-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
    .group { margin-bottom: 1.25rem; overflow: hidden; }
    .group__head { padding: 1rem 0.75rem 0.5rem; }
    .group__title { font-size: 1.05rem; }
    .count {
      font-family: var(--sans); font-size: 0.72rem; font-weight: 700; color: var(--muted);
      border: 1px solid var(--line); border-radius: 100px; padding: 0.1em 0.55em; vertical-align: middle;
    }
    .meta { display: block; font-size: 0.78rem; color: var(--muted); }
    .meta a, td > a { color: inherit; }
    .note-cell { color: var(--muted); max-width: 22rem; }
    .right { text-align: right; white-space: nowrap; }
    .inline { display: inline-flex; gap: 0.35rem; }
    .empty { padding: 3rem 1.5rem; text-align: center; }
    .empty h2 { font-size: 1.3rem; margin-bottom: 0.35rem; }
  </style>
</Admin>
