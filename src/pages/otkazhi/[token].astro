---
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { db, DbError } from '../../lib/db';
import { brand } from '../../data/site';
import { fmtWhen } from '../../lib/format';

export const prerender = false;

const { token } = Astro.params;

type State = 'confirm' | 'done' | 'already' | 'unknown' | 'error';
let state: State = 'confirm';
let title = '';
let starts = '';
let promoted = 0;

// A GET only shows the confirmation; the cancellation itself needs a POST, so
// a link preview or a mail scanner cannot release someone's seat by accident.
if (Astro.request.method === 'POST') {
  try {
    const result = await db.cancelByToken(token!);
    state = result.status === 'already_cancelled' ? 'already' : 'done';
    title = result.event_title;
    starts = result.starts_at;
    promoted = result.promoted;
  } catch (e) {
    state = e instanceof DbError && e.code === 'unknown_token' ? 'unknown' : 'error';
  }
} else {
  // The link lives in an email people keep. Opening it a second time used to
  // ask „Сигурен ли си?“ about a place that had already been given away - and
  // a mistyped link asked the same question about a booking that never
  // existed. Reading the token first costs one query and answers honestly.
  try {
    const found = await db.lookupToken(token!);
    if (!found) {
      state = 'unknown';
    } else if (found.status === 'cancelled') {
      state = 'already';
      title = found.event_title;
      starts = found.starts_at;
    } else {
      title = found.event_title;
      starts = found.starts_at;
    }
  } catch {
    // A lookup that fails must not stop somebody cancelling: fall through to
    // the confirmation and let the POST be the authority.
    state = 'confirm';
  }
}
---

<Base
  title="Отказване на място · Работилница с Джейля"
  description="Освободи мястото си за работилница."
>
  <Header />
  <main id="main" class="cx">
    <div class="wrap--narrow cx__box">
      {state === 'confirm' && (
        <>
          <h1 class="cx__title">Сигурен ли си?</h1>
          <p class="cx__lede">
            {title
              ? <>Отказваш мястото си за <strong>„{title}“</strong> на {fmtWhen(starts)}{' '}</>
              : null}
            Ако натиснеш бутона, мястото ти се освобождава и отива при първия
            човек от листа на чакащите.
          </p>
          <form method="POST">
            <button class="btn" type="submit">Да, откажи мястото ми</button>
          </form>
          <p class="cx__back"><a class="link" href="/">Върни ме обратно</a></p>
        </>
      )}

      {state === 'done' && (
        <>
          <h1 class="cx__title">Готово.</h1>
          <p class="cx__lede">
            Мястото ти за <strong>„{title}“</strong> на {fmtWhen(starts)} е освободено.
            {promoted > 0 && ' Мястото вече е при някого от чакащите.'}
          </p>
          <p class="cx__lede">Ще се радвам да те видя на следваща дата.</p>
          <a class="btn" href="/#rabotilnitsi">Виж другите дати</a>
        </>
      )}

      {state === 'already' && (
        <>
          <h1 class="cx__title">Вече е отказано.</h1>
          <p class="cx__lede">Това място вече беше освободено, не се притеснявай.</p>
          <a class="btn" href="/#rabotilnitsi">Виж свободните дати</a>
        </>
      )}

      {state === 'unknown' && (
        <>
          <h1 class="cx__title">Не намирам такова записване.</h1>
          <p class="cx__lede">
            Може връзката да е стара или непълна. Обади се на
            <a class="link" href={`tel:${brand.phone}`}>{brand.phoneDisplay}</a> и ще го оправя на ръка.
          </p>
        </>
      )}

      {state === 'error' && (
        <>
          <h1 class="cx__title">Нещо се обърка.</h1>
          <p class="cx__lede">
            Не успях да откажа мястото. Пиши ми в
            <a class="link" href={brand.instagram}>Instagram</a> или се обади на
            <a class="link" href={`tel:${brand.phone}`}>{brand.phoneDisplay}</a>.
          </p>
        </>
      )}
    </div>
  </main>
  <Footer />
</Base>

<style>
  .cx { padding-block: 9rem clamp(4rem, 8vw, 7rem); background: var(--paper); }
  .cx__box {
    padding: clamp(2rem, 4vw, 3rem);
    background: var(--paper-warm);
    border: 1px solid var(--rule-soft);
    border-radius: 6px;
  }
  .cx__title { font-size: var(--step-3); margin-bottom: 1rem; }
  .cx__lede { color: var(--muted); max-width: 48ch; }
  .cx__back { margin: 1.2rem 0 0; font-size: var(--step--1); }
</style>
