---
import '@fontsource-variable/manrope/wght.css';
import '@fontsource/playfair-display/cyrillic-400.css';
import { db } from '../lib/db';
import { bookingsPersist } from '../lib/env';

interface Props { title: string; email?: string }
const { title, email } = Astro.props;
const here = Astro.url.pathname;
const persists = bookingsPersist();

const nav = [
  { href: '/admin', label: 'Работилници' },
  { href: '/admin/sadarzhanie', label: 'Съдържание' },
];
---

<!doctype html>
<html lang="bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Панел</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="top">
      <div class="top__in">
        <a class="top__brand" href="/admin">
          <img src="/media/logo-djeilya.png" alt="" width="30" height="30" />
          <span>Панел</span>
        </a>
        <nav class="top__nav">
          {nav.map((n) => (
            <a class={`top__link${here === n.href || (n.href !== '/admin' && here.startsWith(n.href)) ? ' is-here' : ''}`} href={n.href}>
              {n.label}
            </a>
          ))}
        </nav>
        <div class="top__right">
          <a class="top__view" href="/" target="_blank" rel="noopener">Виж сайта ↗</a>
          {email && <span class="top__who">{email}</span>}
          <a class="top__out" href="/admin/izhod">Излез</a>
        </div>
      </div>
      {db.kind === 'local' && persists && (
        <p class="banner">
          Работиш върху локалния файл <code>.data/db.json</code>, не върху Supabase.
          Данните са само на този компютър.
        </p>
      )}
      {!persists && (
        <p class="banner banner--bad">
          Няма свързана база данни. Каквото запишеш тук, изчезва при следващото
          пускане на сървъра, а записването на сайта е спряно — хората виждат
          покана да пишат на имейл. Настрой Supabase (виж <code>SUPABASE.md</code>).
        </p>
      )}
    </header>

    <main class="page"><slot /></main>

    <style is:global>
      :root {
        --ink: #12211A; --muted: #5C6B60; --line: #E2DCCE;
        --paper: #FBF8F1; --card: #FFFFFF; --forest: #1B3A26; --moss: #3E6B43;
        --clay: #9E5330; --warn: #A8791F;
        --sans: 'Manrope Variable', system-ui, sans-serif;
        --display: 'Playfair Display', Georgia, serif;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--paper); color: var(--ink);
        font-family: var(--sans); font-size: 15px; line-height: 1.55;
      }
      a { color: inherit; }
      h1, h2, h3 { font-family: var(--display); font-weight: 400; margin: 0; line-height: 1.15; }
      img { max-width: 100%; display: block; }

      .top { border-bottom: 1px solid var(--line); background: #fff; position: sticky; top: 0; z-index: 10; }
      .top__in {
        display: flex; align-items: center; gap: 1.5rem;
        max-width: 76rem; margin-inline: auto; padding: 0.8rem 1.25rem;
      }
      .top__brand { display: flex; align-items: center; gap: 0.55rem; text-decoration: none; font-weight: 700; }
      .top__brand img { border-radius: 50%; }
      .top__nav { display: flex; gap: 1.2rem; margin-inline-end: auto; }
      .top__link { text-decoration: none; font-size: 0.9rem; padding: 0.35rem 0; border-bottom: 2px solid transparent; color: var(--muted); }
      .top__link:hover { color: var(--ink); }
      .top__link.is-here { color: var(--ink); border-bottom-color: var(--moss); font-weight: 600; }
      .top__right { display: flex; align-items: center; gap: 1rem; font-size: 0.85rem; }
      .top__view, .top__out { text-decoration: none; color: var(--muted); }
      .top__view:hover, .top__out:hover { color: var(--ink); }
      .top__who { color: var(--muted); }

      /* --- phone ---
         The bar was one flex row and ran 63px off the side of a 360px
         screen. Brand and sign-out keep the first line; the sections move to
         a line of their own that can scroll sideways as more are added. */
      @media (max-width: 720px) {
        .top__in { flex-wrap: wrap; gap: 0.7rem 1rem; padding: 0.6rem 1rem; }
        .top__right { margin-inline-start: auto; gap: 1rem; }
        .top__who { display: none; }
        .top__nav {
          order: 3;
          width: 100%;
          margin-inline-end: 0;
          gap: 1.4rem;
          overflow-x: auto;
          scrollbar-width: none;
        }
        .top__nav::-webkit-scrollbar { display: none; }
        .top__link { white-space: nowrap; }
      }
      /* Everything the panel is driven by, sized for a thumb. */
      @media (pointer: coarse) {
        .top__brand, .top__link, .top__view, .top__out {
          display: inline-flex; align-items: center; min-height: 44px;
        }
        .top__link { padding-block: 0; }
        .btn { min-height: 44px; }
        input[type='file'] { min-height: 44px; }
        input[type='checkbox'] { width: 1.25rem; height: 1.25rem; }
        .check { min-height: 44px; }
        a[href^='tel:'], a[href^='mailto:'] {
          display: inline-flex; align-items: center; min-height: 44px;
        }
      }

      .banner {
        margin: 0; padding: 0.5rem 1.25rem; text-align: center;
        background: #FBF3DE; border-top: 1px solid #EBD9AE; color: #6B551F; font-size: 0.82rem;
      }
      .banner code { background: rgb(0 0 0 / 0.05); padding: 0.1em 0.35em; border-radius: 3px; }
      .banner--bad { background: #FBE9E4; color: #7A2E12; }

      .page { max-width: 76rem; margin-inline: auto; padding: 1.75rem 1.25rem 5rem; }

      .card { background: var(--card); border: 1px solid var(--line); border-radius: 8px; }
      .pagehead { display: flex; align-items: end; justify-content: space-between; gap: 1rem; flex-wrap: wrap; margin-bottom: 1.5rem; }
      .pagehead h1 { font-size: 1.9rem; }
      .sub { color: var(--muted); font-size: 0.9rem; margin: 0.35rem 0 0; }

      .btn {
        display: inline-flex; align-items: center; gap: 0.45rem;
        padding: 0.6rem 1.1rem; border-radius: 6px; border: 1px solid var(--forest);
        background: var(--forest); color: #fff; font: inherit; font-size: 0.9rem;
        font-weight: 600; text-decoration: none; cursor: pointer;
      }
      .btn:hover { background: #16301f; }
      .btn--ghost { background: #fff; color: var(--ink); border-color: var(--line); }
      .btn--ghost:hover { background: #F5F1E6; }
      .btn--danger { background: #fff; color: var(--clay); border-color: #E3C6B6; }
      .btn--danger:hover { background: #FBEFE9; }
      .btn--sm { padding: 0.4rem 0.7rem; font-size: 0.82rem; }

      .field { display: grid; gap: 0.3rem; margin-bottom: 1rem; }
      .field > label, .field__label { font-size: 0.82rem; font-weight: 700; }
      .field__hint { font-size: 0.78rem; color: var(--muted); }
      input[type=text], input[type=email], input[type=password], input[type=number],
      input[type=url], input[type=datetime-local], select, textarea {
        font: inherit; font-size: 0.92rem; padding: 0.55rem 0.7rem;
        border: 1px solid var(--line); border-radius: 6px; background: #fff; width: 100%;
      }
      textarea { resize: vertical; min-height: 4.5rem; }
      input:focus, select:focus, textarea:focus {
        outline: none; border-color: var(--moss); box-shadow: 0 0 0 3px rgb(62 107 67 / 0.16);
      }
      .row { display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 0 1rem; }
      .check { display: flex; gap: 0.55rem; align-items: start; font-size: 0.9rem; margin-bottom: 1rem; }
      .check input { margin-top: 0.25em; width: 1rem; height: 1rem; accent-color: var(--moss); }

      .tag { display: inline-block; padding: 0.15em 0.55em; border-radius: 100px; font-size: 0.72rem; font-weight: 700; border: 1px solid; }
      .tag--live { color: var(--moss); border-color: #BBD3B4; background: #F0F6EE; }
      .tag--draft { color: var(--warn); border-color: #E7D3A4; background: #FBF5E6; }
      .tag--off { color: var(--muted); border-color: var(--line); background: #F5F2EA; }

      .note { padding: 0.75rem 1rem; border-radius: 6px; font-size: 0.88rem; margin-bottom: 1.25rem; }
      .note--ok { background: #F0F6EE; border: 1px solid #BBD3B4; color: #29491F; }
      .note--bad { background: #FBEFE9; border: 1px solid #E3C6B6; color: #7A3A1C; }

      table { width: 100%; border-collapse: collapse; font-size: 0.9rem; }
      th { text-align: left; font-size: 0.75rem; color: var(--muted); font-weight: 700; padding: 0.6rem 0.75rem; border-bottom: 1px solid var(--line); }
      td { padding: 0.7rem 0.75rem; border-bottom: 1px solid #F0EBDF; vertical-align: top; }
      tr:last-child td { border-bottom: 0; }

      /* --- phone ---
         A five-column table on a 390px screen pushed the two buttons that
         matter off the right-hand edge, with nothing to say they were there.
         Each row becomes a card instead: everything visible, actions last. */
      @media (max-width: 720px) {
        table, tbody, tr, td { display: block; width: 100%; }
        thead { display: none; }
        tr { padding: 1rem 0.75rem; border-bottom: 1px solid var(--line); }
        tr:last-child { border-bottom: 0; }
        td { padding: 0.1rem 0; border-bottom: 0; }
        /* each cell is a group — workshop, date, seats, status — so give
           them air rather than one undifferentiated stack of lines */
        td + td { padding-top: 0.55rem; }
        td:empty { display: none; }
        td.right {
          text-align: left;
          white-space: normal;
          display: flex;
          gap: 0.5rem;
          margin-top: 0.9rem;
        }
        td.right .btn { margin-left: 0; flex: 1; justify-content: center; }
      }
    </style>
  </body>
</html>
