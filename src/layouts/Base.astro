---
import '@fontsource/playfair-display/cyrillic-400.css';
import '@fontsource/playfair-display/cyrillic-400-italic.css';
import '@fontsource/playfair-display/cyrillic-500.css';
import '@fontsource-variable/manrope/wght.css';
import '../styles/global.css';
import { brand } from '../data/site';
import { u, abs } from '../lib/url';

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: unknown;
}

const {
  title,
  description,
  image = '/media/og.jpg',
  jsonLd,
} = Astro.props;

// The static export writes foo.html and GitHub Pages serves it at /foo, so
// the path a page renders under is not the URL anyone links to. The canonical
// has to name the linked one.
const home = u('/');
const path = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '');
const canonical = new URL(!path || path === home.replace(/\/$/, '') ? home : path, Astro.site);
const ogImage = abs(image, Astro.site);
---

<!doctype html>
<html lang="bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#1B3A26" />

    <!-- Runs before paint. Everything that starts hidden for an entrance
         animation is scoped to .js, so a blocked or broken script leaves a
         fully readable page instead of a blank one. -->
    <script is:inline>document.documentElement.classList.add('js');</script>

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="bg_BG" />
    <meta property="og:site_name" content={`${brand.name} · ${brand.owner}`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Работилница с Джейля — часовник от скандинавски мъх" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" href={u("/favicon.svg")} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={u("/media/logo-djeilya.png")} />

    <link rel="preload" as="image" href={u("/media/hero-gora.jpg")} fetchpriority="high" />

    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd)}
      />
    )}
  </head>

  <body>
    <a class="skip" href="#main">Към основното съдържание</a>
    <div class="grain" aria-hidden="true"></div>
    <slot />

    <script>
      // Reveal on scroll — one observer for the whole page.
      //
      // REPLAY: elements re-hide once they are completely off screen, so the
      // animation plays again on the way back down. The two thresholds give it
      // hysteresis — it reveals at 8% visible but only resets at 0% — so
      // nothing fades out from under someone who is still reading it.
      // Set to false for a one-way reveal.
      const REPLAY = true;

      const items = document.querySelectorAll('[data-reveal]');
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches && items.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.intersectionRatio >= 0.08) {
                entry.target.classList.add('is-in');
                if (!REPLAY) io.unobserve(entry.target);
              } else if (REPLAY && entry.intersectionRatio === 0) {
                entry.target.classList.remove('is-in');
              }
            }
          },
          // A thumb travels a lot faster than a mouse wheel, so on a phone
          // the reveal has to start before the element is properly on screen
          // — otherwise it is still fading in as it goes past.
          {
            rootMargin: window.matchMedia('(max-width: 780px)').matches
              ? '0px 0px 10% 0px'
              : '0px 0px -8% 0px',
            threshold: [0, 0.08],
          }
        );
        items.forEach((el) => io.observe(el));
      } else {
        items.forEach((el) => el.classList.add('is-in'));
      }
    </script>
  </body>
</html>
