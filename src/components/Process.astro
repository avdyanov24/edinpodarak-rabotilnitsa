---
import { u } from '../lib/url';
import { process } from '../data/site';
---

<section class="pr section dark" id="kak-protica" data-process>
  <div class="wrap">
    <header class="pr__head">
      <h2 class="pr__title">{process.title}</h2>
      <p class="pr__lede">{process.lede}</p>
    </header>
  </div>

  <ol class="pr__list wrap">
    <!-- the rail the four moments hang off; fills as the section scrolls -->
    <div class="pr__rail" aria-hidden="true">
      <span class="pr__railFill" data-rail></span>
    </div>

    {process.steps.map((step, i) => (
      <li class="pr__step" data-step style={`--i:${i}`}>
        <div class="pr__mark" aria-hidden="true">
          <span class="pr__node"></span>
          <span class="pr__at">{step.at}</span>
        </div>

        <div class="pr__media">
          <img src={u(step.image)} alt={step.alt} loading="lazy" decoding="async" width="800" height="1000" />
        </div>

        <div class="pr__body">
          <h3 class="pr__stepTitle">{step.title}</h3>
          <p>{step.text}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

<style>
  .pr__head { max-width: 44ch; margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  .pr__title { font-size: var(--step-4); margin-bottom: 0.9rem; }
  .pr__lede { color: var(--muted); margin: 0; }

  .pr__list {
    position: relative;
    list-style: none;
    margin-block: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(1.5rem, 2.5vw, 2.5rem);
  }

  /* --- the rail --- */
  .pr__rail {
    position: absolute;
    top: 7px;
    left: 0;
    right: 0;
    height: 1px;
    background: color-mix(in oklab, var(--cream) 16%, transparent);
  }
  .pr__railFill {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--moss-lt), var(--lichen));
    transform: scaleX(var(--p, 0));
    transform-origin: left;
    transition: transform 0.35s linear;
  }

  .pr__step { display: grid; gap: 1.2rem; align-content: start; }

  .pr__mark { display: flex; align-items: center; gap: 0.7rem; height: 15px; }
  .pr__node {
    width: 15px;
    height: 15px;
    flex: none;
    border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--cream) 35%, transparent);
    background: var(--forest-dp);
    position: relative;
    transition: border-color 0.5s var(--ease);
  }
  .pr__node::after {
    content: "";
    position: absolute;
    inset: 3px;
    border-radius: 50%;
    background: var(--lichen);
    transform: scale(0);
    transition: transform 0.5s var(--ease-out);
  }
  .pr__step.is-on .pr__node { border-color: var(--lichen); }
  .pr__step.is-on .pr__node::after { transform: scale(1); }

  .pr__at {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: color-mix(in oklab, var(--cream) 62%, transparent);
    font-variant-numeric: tabular-nums;
    transition: color 0.5s var(--ease);
  }
  .pr__step.is-on .pr__at { color: var(--lichen); }

  /* --- media --- */
  .pr__media {
    position: relative;
    overflow: hidden;
    border-radius: 3px;
  }
  /* wipes open from the bottom as the step arrives */
  :global(html.js) .pr__media {
    clip-path: inset(0 0 100% 0);
    transition: clip-path 1s var(--ease-out);
    transition-delay: calc(var(--i) * 90ms);
  }
  :global(html.js) .pr__step.is-on .pr__media { clip-path: inset(0 0 0 0); }

  .pr__media img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: saturate(0.85) brightness(0.88);
    transition: transform 1.2s var(--ease-out), filter 0.6s var(--ease);
  }
  :global(html.js) .pr__media img { transform: scale(1.06); }
  :global(html.js) .pr__step.is-on .pr__media img { transform: scale(1); }
  .pr__step:hover .pr__media img { transform: scale(1.05); filter: saturate(1) brightness(1); }


  .pr__stepTitle { font-size: var(--step-1); margin-bottom: 0.5rem; }
  .pr__body p { margin: 0; color: var(--muted); font-size: var(--step--1); line-height: 1.7; }

  /* --- tablet: two up, rail hidden (it would only span half the steps) --- */
  @media (max-width: 1000px) {
    .pr__list { grid-template-columns: repeat(2, 1fr); gap: 2.75rem 1.5rem; }
    .pr__rail { display: none; }
  }

  /* --- phone ---
     The rail used to run down the left with the clock times turned on their
     side, which cost 38px of a 390px screen and made the times a squint.
     Here each moment is announced in a line of its own — dot, time, rule —
     and the photograph takes the full width of the screen, which is the
     whole point of the section. */
  @media (max-width: 620px) {
    .pr__list { grid-template-columns: 1fr; gap: 0; padding-left: 0; }
    .pr__rail { display: none; }

    .pr__step { padding-bottom: 3.25rem; gap: 1rem; }
    .pr__mark { position: static; height: auto; }
    .pr__mark::after {
      content: '';
      flex: 1;
      height: 1px;
      background: color-mix(in oklab, var(--cream) 16%, transparent);
    }
    .pr__mark .pr__at { position: static; writing-mode: horizontal-tb; }

    .pr__media {
      margin-inline: calc(-1 * var(--gutter));
      border-radius: 0;
    }
    .pr__media img { aspect-ratio: 5 / 4; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pr__media { clip-path: none; transition: none; }
    .pr__media img { transform: none; }
    .pr__railFill { transition: none; }
  }

  /* Micro-labels: readable in the hand, not just on a desktop. */
  @media (max-width: 560px), (pointer: coarse) {
    .pr__at { font-size: 0.76rem; letter-spacing: 0.1em; }
  }
</style>

<script>
  const section = document.querySelector('[data-process]');
  const rail = document.querySelector('[data-rail]') as HTMLElement | null;
  const steps = [...document.querySelectorAll<HTMLElement>('[data-step]')];
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (section && steps.length) {
    if (reduce) {
      steps.forEach((s) => s.classList.add('is-on'));
      rail?.style.setProperty('--p', '1');
    } else {
      let ticking = false;
      const update = () => {
        const rect = section.getBoundingClientRect();
        const vh = window.innerHeight;
        // 0 as the section reaches the lower third, 1 once it has cleared the middle
        const raw = (vh * 0.72 - rect.top) / (rect.height * 0.62);
        const p = Math.max(0, Math.min(1, raw));

        rail?.style.setProperty('--p', p.toFixed(3));
        // A node lights just before the rail reaches it, so the fill leads.
        // Both the rail and the photo wipe follow the scroll in either
        // direction, so the sequence replays on the way back down.
        steps.forEach((step, i) => {
          step.classList.toggle('is-on', p >= (i + 0.15) / steps.length);
        });
        ticking = false;
      };
      window.addEventListener('scroll', () => {
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
      }, { passive: true });
      window.addEventListener('resize', update, { passive: true });
      update();
    }
  }
</script>
