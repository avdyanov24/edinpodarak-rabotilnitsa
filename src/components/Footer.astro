---
import { u } from '../lib/url';
import { brand, legal } from '../data/site';
const year = new Date().getFullYear();

// Split at build time so each letter can be staggered without shipping JS
// to do it. The link keeps an aria-label, and the letters are hidden from
// assistive tech so the name is never spelled out one character at a time.
const letters = [...legal.studioName];
---

<footer class="ft dark">
  <div class="wrap">
    <div class="ft__top">
      <div class="ft__brand">
        <img src={u("/media/logo-djeilya.png")} alt="" width="72" height="72" loading="lazy" />
        <p class="ft__claim">
          Работилници със скандинавски мъх в {brand.city}.<br />
          Води ги {brand.owner}.
        </p>
      </div>

      <nav class="ft__nav" aria-label="Долна навигация">
        <div>
          <h2 class="ft__h">Страницата</h2>
          <a class="link" href="#rabotilnitsi">Предстоящи работилници</a>
          <a class="link" href="#kak-protica">Как протича</a>
          <a class="link" href="#galeriya">Галерия</a>
          <a class="link" href="#vaprosi">Въпроси</a>
          <a class="link" href="#grupi">За групи</a>
        </div>
        <div>
          <h2 class="ft__h">Връзка</h2>
          <a class="link" href={`tel:${brand.phone}`}>{brand.phoneDisplay}</a>
          <a class="link" href={`mailto:${brand.email}`}>{brand.email}</a>
          <a class="link" href={brand.instagram}>Instagram</a>
          <a class="link" href={brand.facebook}>Facebook</a>
        </div>
        <div>
          <h2 class="ft__h">Джейля</h2>
          <a class="link" href={brand.shopUrl}>Онлайн магазин</a>
          <a class="link" href={u("/poveritelnost")}>Поверителност</a>
          <a class="link" href={u("/usloviya")}>Условия</a>
        </div>
      </nav>
    </div>

    <div class="ft__bottom">
      <p>© {year} {brand.owner}. Всички права запазени.</p>
      <p class="ft__credit">
        <span class="ft__creditPre">Изработено от</span>
        <a
          class="st"
          href={legal.studioUrl}
          aria-label={legal.studioName}
          data-studio
        >
          <span class="st__word" aria-hidden="true">
            {letters.map((ch, i) => (
              <span class="st__l" style={`--i:${i}`}>{ch === ' ' ? '\u00A0' : ch}</span>
            ))}
            <span class="st__line"></span>
          </span>
          <span class="st__sprig" aria-hidden="true">
            <svg viewBox="0 0 26 8" width="26" height="8" fill="currentColor">
              <circle class="st__dot" style="--d:0" cx="4" cy="4" r="2.6" />
              <circle class="st__dot" style="--d:1" cx="13" cy="4" r="1.8" />
              <circle class="st__dot" style="--d:2" cx="21" cy="4" r="1.1" />
            </svg>
          </span>
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .ft { padding-block: clamp(3.5rem, 7vw, 6rem) 2rem; }
  .ft__top {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr);
    gap: clamp(2.5rem, 5vw, 4rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--rule);
  }
  .ft__brand img { border-radius: 50%; background: var(--cream); margin-bottom: 1.2rem; }
  .ft__claim { font-family: var(--display); font-size: var(--step-1); line-height: 1.45; margin: 0; }

  .ft__nav { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .ft__nav > div { display: grid; gap: 0.55rem; align-content: start; }
  .ft__nav a { text-decoration: none; font-size: var(--step--1); color: var(--muted); justify-self: start; }
  .ft__nav a:hover { color: var(--cream); }
  .ft__h {
    font-family: var(--sans);
    font-size: 0.66rem;
    letter-spacing: 0.02em;
    color: var(--lichen);
    margin-bottom: 0.5rem;
    font-weight: 700;
  }

  .ft__bottom {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-top: 1.8rem;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .ft__bottom p { margin: 0; }
  .ft__creditPre { color: var(--muted); }

  /* ============================================================
     The studio credit. Three things happen:
       · it arrives  — letters rise in sequence, the rule draws, moss sprouts
       · it glints   — one slow sweep across the name, once, unprompted
       · it responds — a wave through the letters on hover or focus
     ============================================================ */
  .st {
    position: relative;
    display: inline-flex;
    align-items: baseline;
    gap: 0.45em;
    text-decoration: none;
    color: var(--lichen);
    isolation: isolate;
  }

  /* Deliberately not clipped. Clipping the sweep at the word's edge cuts the
     bright core into a hard vertical line; the band's own alpha already fades
     to nothing, so it can hang over its neighbours invisibly instead. */
  .st__word {
    position: relative;
    display: inline-flex;
    padding-bottom: 0.4em;
  }

  .st__l {
    display: inline-block;
    white-space: pre;
    transition:
      transform 0.55s var(--ease-out),
      color 0.4s var(--ease);
    /* left-to-right on the way in, and again on hover */
    transition-delay: calc(var(--i) * 28ms);
    will-change: transform;
  }

  /* --- arrival --- */
  :global(html.js) .st__l { transform: translateY(0.7em); opacity: 0; }
  :global(html.js) .st__l { transition-property: transform, opacity, color; }
  :global(html.js) .st.is-in .st__l { transform: none; opacity: 1; }

  /* --- the glint: one pass, after the letters have landed --- */
  /* The glint runs through the letterforms themselves rather than as a
     gradient band over them. A band has to be clipped to a box, and clipping
     a soft gradient always leaves a visible edge somewhere in the sweep. */
  :global(html.js) .st.is-in .st__l {
    animation: stGlint 0.85s var(--ease) calc(var(--i) * 42ms + 620ms) 1;
  }
  @keyframes stGlint {
    0%, 100% { color: var(--lichen); text-shadow: none; }
    45% {
      color: #FFFDF6;
      text-shadow: 0 0 14px rgb(244 238 226 / 0.5), 0 0 4px rgb(244 238 226 / 0.35);
    }
  }

  /* --- the rule under the name --- */
  .st__line {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 1px;
    width: 100%;
    background: currentColor;
    opacity: 0.4;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.7s var(--ease-out), opacity 0.4s var(--ease), background-color 0.4s var(--ease);
  }
  :global(html.js) .st.is-in .st__line { transform: scaleX(1); transition-delay: 0.25s; }

  /* --- moss sprouting after the name --- */
  .st__sprig { display: inline-flex; align-self: center; line-height: 0; color: var(--moss-lt); }
  .st__dot {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.5s var(--ease-out), opacity 0.4s var(--ease);
    transition-delay: calc(var(--d) * 90ms + 0.5s);
  }
  :global(html.js) .st__dot { transform: scale(0); opacity: 0; }
  :global(html.js) .st.is-in .st__dot { transform: scale(1); opacity: 1; }

  /* --- hover / focus: a wave runs through the letters ---
     Written at the same weight as the arrival rules above, which would
     otherwise win and pin the letters at transform: none. --- */
  .st:hover .st__l,
  .st:focus-visible .st__l,
  :global(html.js) .st.is-in:hover .st__l,
  :global(html.js) .st.is-in:focus-visible .st__l {
    transform: translateY(-0.22em);
    color: var(--cream);
  }
  .st:hover .st__line,
  .st:focus-visible .st__line,
  :global(html.js) .st.is-in:hover .st__line,
  :global(html.js) .st.is-in:focus-visible .st__line {
    opacity: 1;
    background: var(--moss-lt);
    /* redraw rather than just recolour */
    animation: stSweep 0.75s var(--ease-out);
  }
  @keyframes stSweep {
    0%   { transform: scaleX(0); transform-origin: left; }
    100% { transform: scaleX(1); transform-origin: left; }
  }
  .st:hover .st__dot,
  .st:focus-visible .st__dot,
  :global(html.js) .st.is-in:hover .st__dot,
  :global(html.js) .st.is-in:focus-visible .st__dot { transform: scale(1.45); }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .st__l { transform: none; opacity: 1; }
    :global(html.js) .st__dot { transform: scale(1); opacity: 1; }
    :global(html.js) .st.is-in .st__shine { animation: none; }
    .st__line { transform: scaleX(1); }
    :global(html.js) .st.is-in:hover .st__l,
    .st:hover .st__l, .st:focus-visible .st__l { transform: none; }
    .st:hover .st__line, .st:focus-visible .st__line { animation: none; }
    :global(html.js) .st.is-in:hover .st__dot,
    .st:hover .st__dot, .st:focus-visible .st__dot { transform: scale(1); }
  }

  @media (max-width: 820px) {
    .ft__top { grid-template-columns: 1fr; }
    .ft__nav { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 460px) { .ft__nav { grid-template-columns: 1fr; } }

  /* Micro-labels: readable in the hand, not just on a desktop. */
  @media (max-width: 560px), (pointer: coarse) {
    .ft__h { font-size: 0.78rem; letter-spacing: 0.01em; }
  }

  /* Thumb-sized targets on phones. */
  @media (max-width: 560px), (pointer: coarse) {
    .ft__nav a.link { display: flex; align-items: center; min-height: 44px; }
    .ft__credit .st { padding-block: 0.6rem; }
  }
</style>

<script>
  // Its own observer rather than [data-reveal], so the credit keeps its
  // letter-by-letter sequence instead of fading in as one block — and so it
  // replays every time the footer comes back into view.
  const credit = document.querySelector('[data-studio]') as HTMLElement | null;

  if (credit) {
    credit.style.setProperty('--letters', String(credit.querySelectorAll('.st__l').length));

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      credit.classList.add('is-in');
    } else {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (entry.intersectionRatio >= 0.6) credit.classList.add('is-in');
          else if (entry.intersectionRatio === 0) credit.classList.remove('is-in');
        },
        { threshold: [0, 0.6] }
      );
      io.observe(credit);
    }
  }
</script>
