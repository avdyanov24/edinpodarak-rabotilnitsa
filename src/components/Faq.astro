---
import { faq, brand } from '../data/site';
import type { FaqItem } from '../lib/content';

interface Props { items?: FaqItem[] }
const { items = faq.items } = Astro.props;
---

<section class="faq section" id="vaprosi">
  <div class="wrap faq__grid">
    <header class="faq__head">
      <h2 class="faq__title">{faq.title}</h2>

      <aside class="faq__help">
        <h3 class="faq__helpTitle">{faq.helpTitle}</h3>
        <p>{faq.helpText}</p>
        <div class="faq__helpLinks">
          <a class="link" href={`tel:${brand.phone}`}>{brand.phoneDisplay}</a>
          <a class="link" href={brand.instagram}>Instagram</a>
        </div>
      </aside>
    </header>

    <div class="faq__items" data-faq>
      {items.map((item) => (
        <details class="faq__item">
          <summary class="faq__q">
            <span class="faq__qText">{item.q}</span>
            <span class="faq__icon" aria-hidden="true"></span>
          </summary>
          <div class="faq__a"><p>{item.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq { background: var(--paper-warm); }
  .faq__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .faq__head { position: sticky; top: 6.5rem; }
  .faq__title { font-size: var(--step-4); }

  .faq__help {
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: clamp(1.4rem, 2.4vw, 1.9rem);
    background: var(--paper);
    border: 1px solid var(--rule-soft);
    border-radius: 6px;
  }
  .faq__helpTitle { font-size: var(--step-1); margin-bottom: 0.4rem; }
  .faq__help p { margin: 0 0 1rem; color: var(--muted); font-size: var(--step--1); }
  .faq__helpLinks { display: flex; gap: 1.2rem; flex-wrap: wrap; font-size: var(--step--1); font-weight: 600; color: var(--moss); }
  .faq__helpLinks a { text-decoration: none; }

  .faq__item { border-top: 1px solid var(--rule); }
  .faq__item:last-child { border-bottom: 1px solid var(--rule); }

  .faq__q {
    display: flex;
    align-items: baseline;
    gap: clamp(0.8rem, 1.6vw, 1.4rem);
    padding-block: 1.4rem;
    cursor: pointer;
    list-style: none;
    transition: color 0.3s var(--ease);
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q:hover { color: var(--moss); }


  .faq__qText { flex: 1; font-family: var(--display); font-size: var(--step-1); }

  .faq__icon { position: relative; width: 14px; height: 14px; flex: none; align-self: center; }
  .faq__icon::before, .faq__icon::after {
    content: "";
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    background: currentColor;
    transition: transform 0.45s var(--ease-out);
  }
  .faq__icon::after { transform: rotate(90deg); }
  .faq__item[open] .faq__icon::after { transform: rotate(0deg); }
  .faq__item[open] .faq__q { color: var(--moss); }

  /* JS animates the height; this is the resting layout */
  .faq__a { overflow: hidden; }
  .faq__a p {
    margin: 0;
    padding: 0 0 1.5rem;
    max-width: 58ch;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .faq__grid { grid-template-columns: 1fr; }
    /* One column, so the "didn't find your answer" box has to come after the
       questions rather than before anyone has read one. `order` only moves
       grid items, and the box is nested inside the header — display: contents
       lifts the header's children into the grid so it can be moved. */
    .faq__head { display: contents; }
    .faq__title { order: 0; }
    .faq__items { order: 1; }
    .faq__help { order: 2; margin-top: clamp(2rem, 6vw, 3rem); }
  }
</style>

<script>
  // <details> gives us the semantics; this adds the open/close motion and
  // keeps only one answer open at a time (without the `name` attribute, which
  // would slam the others shut with no animation).
  const root = document.querySelector('[data-faq]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const DURATION = 380;

  if (root) {
    const items = [...root.querySelectorAll<HTMLDetailsElement>('.faq__item')];

    const slide = (panel: HTMLElement, from: number, to: number, done?: () => void) => {
      if (reduce.matches) { panel.style.height = ''; done?.(); return; }
      const anim = panel.animate(
        [{ height: `${from}px`, opacity: from ? 1 : 0 }, { height: `${to}px`, opacity: to ? 1 : 0 }],
        { duration: DURATION, easing: 'cubic-bezier(0.16, 1, 0.3, 1)' }
      );
      anim.onfinish = () => { panel.style.height = ''; done?.(); };
    };

    const close = (item: HTMLDetailsElement) => {
      const panel = item.querySelector('.faq__a') as HTMLElement;
      const from = panel.scrollHeight;
      slide(panel, from, 0, () => { item.open = false; });
    };

    items.forEach((item) => {
      const summary = item.querySelector('summary') as HTMLElement;
      const panel = item.querySelector('.faq__a') as HTMLElement;

      summary.addEventListener('click', (e) => {
        e.preventDefault();

        if (item.open) { close(item); return; }

        items.filter((other) => other !== item && other.open).forEach(close);

        item.open = true;
        slide(panel, 0, panel.scrollHeight);
      });
    });
  }
</script>
