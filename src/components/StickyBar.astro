---
import type { WorkshopEvent } from '../data/events';
import { fmtDate, fmtTime, availability } from '../lib/format';

interface Props { next?: WorkshopEvent }
const { next } = Astro.props;
const a = next ? availability(next.capacity, next.seats_taken, next.registrations_open) : null;
---

{next && a && (
  <div class="sticky" data-sticky hidden>
    <div class="sticky__info">
      <strong>{next.title}</strong>
      <span class="sticky__meta">
        <span class="sticky__when">{fmtDate(next.starts_at)}, {fmtTime(next.starts_at)}</span>
        <span class="sticky__dot" aria-hidden="true">·</span>
        <span class={`sticky__seats${a.full ? ' is-full' : ''}`}>{a.label}</span>
      </span>
    </div>
    {a.full && next.waitlist_enabled ? (
      <button class="btn btn--ghost sticky__btn" type="button" data-signup={next.id} data-waitlist="1">
        Чакащи
      </button>
    ) : (
      <button class="btn sticky__btn" type="button" data-signup={next.id}>Запиши се</button>
    )}
  </div>
)}

<style>
  .sticky {
    position: fixed;
    inset: auto 0 0;
    z-index: 850;
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.75rem var(--gutter) calc(0.75rem + env(safe-area-inset-bottom));
    background: color-mix(in oklab, var(--paper) 94%, transparent);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-top: 1px solid var(--rule);
    transform: translateY(100%);
    transition: transform 0.5s var(--ease-out);
  }
  .sticky[hidden] { display: none; }
  .sticky.is-up { transform: none; }
  .sticky__info { display: grid; min-width: 0; line-height: 1.3; }
  .sticky__info strong { font-family: var(--display); font-size: 1.05rem; font-weight: 500; }
  /* The line used to be one string with an ellipsis on it, and on a 390px
     screen the part that got cut was „Свободни 8 места“ — the number that
     makes someone tap. Splitting it lets the date give way first and keeps
     the count whole at any width. */
  .sticky__meta {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    min-width: 0;
    font-size: 0.75rem;
    color: var(--muted);
  }
  .sticky__when { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .sticky__dot { flex: none; opacity: 0.55; }
  .sticky__seats { flex: none; color: var(--moss); font-weight: 600; }
  .sticky__seats.is-full { color: var(--clay-ink); }
  .sticky__btn { margin-inline-start: auto; flex: none; padding: 0.75em 1.25em; }

  /* Below about 400px the date and the count cannot share a line whatever
     the type size, and „декември“ is longer than „септември“. Rather than cut
     one of them, let them stack. */
  @media (max-width: 400px) {
    .sticky__meta { flex-wrap: wrap; row-gap: 0; }
    .sticky__when { overflow: visible; text-overflow: clip; }
    .sticky__dot { display: none; }
  }

  @media (min-width: 861px) { .sticky { display: none; } }
</style>

<script>
  const bar = document.querySelector('[data-sticky]') as HTMLElement | null;
  const events = document.querySelector('#rabotilnitsi');
  const footer = document.querySelector('.ft');

  if (bar && events) {
    bar.hidden = false;
    // Show it once the hero is behind you, hide it again over the footer
    // (where the same call-to-action is already on screen).
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.target === events) {
            bar.classList.toggle('is-up', entry.boundingClientRect.top < 0 || entry.isIntersecting);
          }
          if (entry.target === footer && entry.isIntersecting) {
            bar.classList.remove('is-up');
          }
        }
      },
      { threshold: 0.02 }
    );
    io.observe(events);
    if (footer) io.observe(footer);
  }
</script>
