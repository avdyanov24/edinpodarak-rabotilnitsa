---
import { u } from '../lib/url';
import { brand } from '../data/site';

/**
 * Four identical rows treated every channel as equally likely, which is not
 * how she actually works — Instagram is where she answers within the hour.
 * So one channel leads and the rest are there for the people who prefer them.
 */
const others = [
  { k: 'Телефон', v: brand.phoneDisplay, href: `tel:${brand.phone}`, icon: 'tel' },
  { k: 'Имейл', v: brand.email, href: `mailto:${brand.email}`, icon: 'mail' },
  { k: 'Facebook', v: 'Djeilqart', href: brand.facebook, icon: 'fb' },
];
---

<section class="ct section" id="kontakti">
  <div class="wrap ct__grid">
    <div class="ct__main">
      <h2 class="ct__title">Питай ме каквото искаш</h2>
      <p class="ct__lede">
        Ако нещо не ти е ясно преди да се запишеш - пиши или се обади. Няма
        глупав въпрос, всички ги задават за пръв път.
      </p>

      <a class="ct__lead" href={brand.instagram} rel="me">
        <span class="ct__leadIcon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.6">
            <rect x="3" y="3" width="18" height="18" rx="5" />
            <circle cx="12" cy="12" r="4" />
            <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
          </svg>
        </span>
        <span class="ct__leadText">
          <strong>@djeilqart</strong>
          <span>Пиши ми в Instagram - тук отговарям най-бързо</span>
        </span>
        <span class="ct__leadGo" aria-hidden="true">
          <svg viewBox="0 0 20 20" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.7">
            <path d="M4 10h11M11 5.5 15.5 10 11 14.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </span>
      </a>

      <ul class="ct__others">
        {others.map((c) => (
          <li>
            <a class="ct__chip" href={c.href} rel={c.icon === 'fb' ? 'me' : undefined}>
              <span class="ct__chipIcon" aria-hidden="true">
                {c.icon === 'tel' && (
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7">
                    <path d="M6.5 3h3l1.5 4.5-2 1.5a12 12 0 0 0 6 6l1.5-2 4.5 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3Z" stroke-linejoin="round" />
                  </svg>
                )}
                {c.icon === 'mail' && (
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7">
                    <rect x="3" y="5" width="18" height="14" rx="2.5" />
                    <path d="m3.8 7 8.2 6 8.2-6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
                {c.icon === 'fb' && (
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7">
                    <path d="M14.5 8.5h2.2M14.5 21V9.8c0-1.6.9-2.8 2.6-2.8h1.4" stroke-linecap="round" />
                    <path d="M11 12.6h5.5" stroke-linecap="round" />
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                  </svg>
                )}
              </span>
              <span class="ct__chipV">{c.v}</span>
            </a>
          </li>
        ))}
      </ul>

      <!-- The address is settled now, so it is written here. Making someone
           open an event page to find out where they would be going is a
           friction that costs bookings. -->
      <p class="ct__where">
        Работилниците са в <strong>{brand.venue}, {brand.city}</strong> -
        <a class="link" href={brand.mapUrl} target="_blank" rel="noopener">виж на картата</a>.
        Ако някоя е на друго място, пише го при самата дата.
      </p>
    </div>

    <aside class="ct__shop">
      <img class="ct__logo" src={u("/media/logo-djeilya.png")} alt="" width="120" height="120" loading="lazy" />
      <h3 class="ct__shopTitle">Не можеш да дойдеш?</h3>
      <p>
        Същите неща ги правя и по поръчка - картини, часовници и подаръци с
        послание от скандинавски мъх - в онлайн магазина.
      </p>
      <a class="btn btn--ghost" href={brand.shopUrl}>Разгледай магазина</a>
    </aside>
  </div>
</section>

<style>
  .ct { background: var(--paper); }
  .ct__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
  }
  .ct__title { font-size: var(--step-4); margin-bottom: 1rem; }
  .ct__lede { color: var(--muted); max-width: 42ch; margin-bottom: 2.25rem; }

  /* --- the channel she actually answers on --- */
  .ct__lead {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2vw, 1.3rem);
    padding: clamp(1.1rem, 2.4vw, 1.5rem) clamp(1.2rem, 2.6vw, 1.6rem);
    margin-bottom: 1rem;
    border-radius: 8px;
    background: var(--forest-dp);
    color: var(--cream);
    text-decoration: none;
    position: relative;
    overflow: hidden;
    isolation: isolate;
    transition: transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out);
  }
  /* a corner of real moss, so the card belongs to this site and not a kit */
  .ct__lead::after {
    content: "";
    position: absolute;
    inset: auto -12% -60% auto;
    width: 16rem;
    height: 16rem;
    z-index: -1;
    background: url('/media/texture/glina.webp') center / cover;
    opacity: 0.3;
    filter: saturate(1.1);
    mask-image: radial-gradient(60% 60% at 70% 70%, #000, transparent 72%);
    transition: transform 1.4s var(--ease-out), opacity 0.6s var(--ease);
  }
  .ct__lead:hover { transform: translateY(-2px); box-shadow: 0 18px 40px -22px rgb(9 20 14 / 0.7); }
  .ct__lead:hover::after { transform: scale(1.12) rotate(-4deg); opacity: 0.42; }

  .ct__leadIcon {
    flex: none;
    width: 3rem;
    height: 3rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid color-mix(in oklab, var(--cream) 32%, transparent);
  }
  .ct__leadText { display: grid; gap: 0.15rem; min-width: 0; }
  .ct__leadText strong {
    font-family: var(--display);
    font-size: var(--step-2);
    font-weight: 500;
    overflow-wrap: anywhere;
  }
  .ct__leadText span {
    font-size: var(--step--1);
    color: color-mix(in oklab, var(--cream) 78%, transparent);
  }
  .ct__leadGo {
    flex: none;
    margin-inline-start: auto;
    color: var(--lichen);
    transition: transform 0.45s var(--ease-out);
  }
  .ct__lead:hover .ct__leadGo { transform: translateX(4px); }

  /* --- the rest, as chips rather than a fifth of the page --- */
  .ct__others {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .ct__chip {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid var(--rule);
    border-radius: 100px;
    text-decoration: none;
    color: var(--ink);
    font-size: var(--step--1);
    transition: border-color 0.3s var(--ease), background-color 0.3s var(--ease);
  }
  .ct__chip:hover { border-color: var(--moss); background: var(--paper-warm); }
  .ct__chipIcon { color: var(--moss); display: grid; place-items: center; }
  .ct__chipV { overflow-wrap: anywhere; }

  .ct__where {
    margin: 0;
    padding-top: 1.4rem;
    border-top: 1px solid var(--rule-soft);
    font-size: var(--step--1);
    color: var(--muted);
    max-width: 52ch;
  }
  .ct__where strong { color: var(--ink); font-weight: 600; }

  .ct__shop {
    padding: clamp(1.8rem, 3.5vw, 2.8rem);
    background: var(--paper-warm);
    border: 1px solid var(--rule-soft);
    border-radius: 6px;
    display: grid;
    gap: 1rem;
    justify-items: start;
    position: sticky;
    top: 6.5rem;
  }
  /* The logo file carries its own white square; masking it into a disc on
     the warm ground stops it reading as a pasted-in asset. */
  .ct__logo {
    width: 76px;
    height: 76px;
    border-radius: 50%;
    object-fit: cover;
    border: 1px solid var(--rule-soft);
  }
  .ct__shopTitle { font-size: var(--step-2); }
  .ct__shop p { color: var(--muted); margin: 0; font-size: var(--step--1); }

  @media (max-width: 860px) {
    .ct__grid { grid-template-columns: 1fr; }
    .ct__shop { position: static; }
  }
  @media (max-width: 560px) {
    .ct__link { flex-wrap: wrap; gap: 0.5rem 0.8rem; }
    .ct__k { width: auto; }
    .ct__v { flex: 1 0 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ct__link:hover { padding-left: 0; }
  }

  /* Micro-labels: readable in the hand, not just on a desktop. */
  @media (max-width: 560px), (pointer: coarse) {
    .ct__k { font-size: 0.78rem; letter-spacing: 0.01em; }
    .ct__note { font-size: 0.76rem; letter-spacing: 0.01em; }
  }
</style>
