---
import { u } from '../lib/url';
import { brand } from '../data/site';

const channels = [
  {
    k: 'Instagram',
    v: '@djeilqart',
    href: brand.instagram,
    note: 'най-бързо',
    icon: 'ig',
  },
  { k: 'Телефон', v: brand.phoneDisplay, href: `tel:${brand.phone}`, note: '', icon: 'tel' },
  { k: 'Имейл', v: brand.email, href: `mailto:${brand.email}`, note: '', icon: 'mail' },
  { k: 'Facebook', v: 'Djeilqart', href: brand.facebook, note: '', icon: 'fb' },
];
---

<section class="ct section" id="kontakti">
  <div class="wrap ct__grid">
    <div class="ct__main">
      <h2 class="ct__title">Питай ме каквото искаш</h2>
      <p class="ct__lede">
        Ако нещо не ти е ясно преди да се запишеш — пиши или се обади. Няма
        глупав въпрос, всички ги задават за пръв път.
      </p>

      <ul class="ct__list">
        {channels.map((c) => (
          <li class="ct__row">
            <a class="ct__link" href={c.href} rel={c.icon === 'ig' || c.icon === 'fb' ? 'me' : undefined}>
              <span class="ct__icon" aria-hidden="true">
                {c.icon === 'ig' && (
                  <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
                  </svg>
                )}
                {c.icon === 'tel' && (
                  <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6">
                    <path d="M6.5 3h3l1.5 4.5-2 1.5a12 12 0 0 0 6 6l1.5-2 4.5 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3Z" stroke-linejoin="round" />
                  </svg>
                )}
                {c.icon === 'mail' && (
                  <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6">
                    <rect x="3" y="5" width="18" height="14" rx="2.5" />
                    <path d="m3.8 7 8.2 6 8.2-6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
                {c.icon === 'fb' && (
                  <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6">
                    <path d="M14.5 8.5h2.2M14.5 21V9.8c0-1.6.9-2.8 2.6-2.8h1.4" stroke-linecap="round" />
                    <path d="M11 12.6h5.5" stroke-linecap="round" />
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                  </svg>
                )}
              </span>
              <span class="ct__k">{c.k}</span>
              <span class="ct__v">{c.v}</span>
              {c.note && <span class="ct__note">{c.note}</span>}
              <span class="ct__arrow" aria-hidden="true">
                <svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.6">
                  <path d="M4 10h11M11 5.5 15.5 10 11 14.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>

      <p class="ct__where">
        Работилниците се провеждат в <strong>{brand.city}</strong>. Точният адрес е
        описан при всяка дата и го получаваш и в имейла за потвърждение.
      </p>
    </div>

    <aside class="ct__shop">
      <img class="ct__logo" src={u("/media/logo-djeilya.png")} alt="" width="120" height="120" loading="lazy" />
      <h3 class="ct__shopTitle">Не можеш да дойдеш?</h3>
      <p>
        Същите неща ги правя и по поръчка — картини, часовници и подаръци с
        послание от скандинавски мъх.
      </p>
      <a class="btn btn--ghost" href={brand.shopUrl}>Разгледай магазина</a>
    </aside>
  </div>
</section>

<style>
  .ct { background: var(--paper); }
  .ct__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
  }
  .ct__title { font-size: var(--step-4); margin-bottom: 1rem; }
  .ct__lede { color: var(--muted); max-width: 42ch; margin-bottom: 2.25rem; }

  .ct__list { list-style: none; margin: 0 0 2rem; padding: 0; display: grid; }
  .ct__row { border-top: 1px solid var(--rule-soft); }
  .ct__row:last-child { border-bottom: 1px solid var(--rule-soft); }

  .ct__link {
    display: flex;
    align-items: center;
    gap: clamp(0.8rem, 1.8vw, 1.4rem);
    padding: 1.05rem 0;
    text-decoration: none;
    transition: padding-left 0.45s var(--ease-out), color 0.3s var(--ease);
  }
  .ct__link:hover { padding-left: 0.7rem; color: var(--moss); }

  .ct__icon {
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    border: 1px solid var(--rule);
    color: var(--moss);
    transition: background-color 0.35s var(--ease), border-color 0.35s var(--ease), color 0.35s var(--ease);
  }
  .ct__link:hover .ct__icon {
    background: var(--moss);
    border-color: var(--moss);
    color: var(--paper);
  }

  .ct__k {
    flex: none;
    width: 6.5rem;
    font-size: 0.64rem;
    letter-spacing: 0.02em;
    font-weight: 700;
    color: var(--muted);
  }
  .ct__v { font-family: var(--display); font-size: var(--step-1); flex: 1; min-width: 0; overflow-wrap: anywhere; }
  .ct__note {
    flex: none;
    font-size: 0.62rem;
    letter-spacing: 0.02em;
    font-weight: 700;
    color: var(--clay-ink);
    padding: 0.3em 0.7em;
    border: 1px solid color-mix(in oklab, var(--clay) 45%, transparent);
    border-radius: 100px;
  }
  .ct__arrow {
    flex: none;
    color: var(--moss);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.35s var(--ease), transform 0.35s var(--ease-out);
  }
  .ct__link:hover .ct__arrow { opacity: 1; transform: none; }

  .ct__where {
    margin: 0;
    padding-top: 1.4rem;
    border-top: 1px solid var(--rule-soft);
    font-size: var(--step--1);
    color: var(--muted);
    max-width: 52ch;
  }
  .ct__where strong { color: var(--ink); font-weight: 600; }

  .ct__shop {
    padding: clamp(1.8rem, 3.5vw, 2.8rem);
    background: var(--paper-warm);
    border: 1px solid var(--rule-soft);
    border-radius: 6px;
    display: grid;
    gap: 1rem;
    justify-items: start;
    position: sticky;
    top: 6.5rem;
  }
  .ct__logo { width: 84px; height: auto; }
  .ct__shopTitle { font-size: var(--step-2); }
  .ct__shop p { color: var(--muted); margin: 0; font-size: var(--step--1); }

  @media (max-width: 860px) {
    .ct__grid { grid-template-columns: 1fr; }
    .ct__shop { position: static; }
  }
  @media (max-width: 560px) {
    .ct__link { flex-wrap: wrap; gap: 0.5rem 0.8rem; }
    .ct__k { width: auto; }
    .ct__v { flex: 1 0 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ct__link:hover { padding-left: 0; }
  }

  /* Micro-labels: readable in the hand, not just on a desktop. */
  @media (max-width: 560px), (pointer: coarse) {
    .ct__k { font-size: 0.78rem; letter-spacing: 0.01em; }
    .ct__note { font-size: 0.76rem; letter-spacing: 0.01em; }
  }
</style>
