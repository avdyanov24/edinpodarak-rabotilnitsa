---
import { u } from '../lib/url';
import { included } from '../data/site';
---

<section class="inc section" data-included>
  <div class="wrap inc__grid">
    <div class="inc__media">
      <div class="inc__stack">
        <!-- resting state: what is on the table before anyone touches it -->
        <img
          class="inc__layer inc__video"
          src={u("/media/workshop/oformyane.webp")}
          alt=""
          aria-hidden="true"
          loading="lazy"
          decoding="async"
          width="1300" height="867"
        />

        {included.items.map((item, i) => (
          <img
            class="inc__layer inc__photo"
            data-layer={i}
            src={u(item.image)}
            alt=""
            aria-hidden="true"
            loading="lazy"
            decoding="async"
            width="1000" height="1250"
          />
        ))}

        <span class="inc__caption" data-caption>
          Глината помни всяко докосване. Затова никои две чаши не излизат еднакви.
        </span>
      </div>
    </div>

    <div class="inc__body">
      <h2 class="inc__title">{included.title}</h2>
      <p class="inc__lede">{included.lede}</p>

      <ul class="inc__list" data-list>
        {included.items.map((item, i) => (
          <li class="inc__item" data-item={i} data-reveal style={`--reveal-delay:${i * 60}ms`}>
            <button class="inc__row" type="button" aria-describedby="inc-hint">
              <span class="inc__text">
                <strong>{item.title}</strong>
                <span>{item.text}</span>
              </span>
              <span class="inc__thumb" aria-hidden="true">
                <img src={u(item.image)} alt="" loading="lazy" decoding="async" width="120" height="120" />
              </span>
            </button>
            <span class="inc__underline" aria-hidden="true"></span>
          </li>
        ))}
      </ul>

      <p class="inc__hint" id="inc-hint">Мини с мишката по списъка, за да видиш всяко от тях.</p>
    </div>
  </div>
</section>

<style>
  .inc { background: var(--paper); }
  .inc__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 5vw, 5rem);
    align-items: start;
  }

  /* --- media panel --- */
  .inc__media { position: sticky; top: 6rem; }
  .inc__stack {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: 6px;
    overflow: hidden;
    background: var(--forest-dp);
    box-shadow: 0 24px 50px -30px rgb(18 33 26 / 0.7);
  }
  .inc__layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .inc__photo {
    opacity: 0;
    transform: scale(1.045);
    transition: opacity 0.55s var(--ease), transform 1.1s var(--ease-out);
  }
  .inc__photo.is-shown { opacity: 1; transform: scale(1); }

  .inc__caption {
    position: absolute;
    inset: auto 0 0;
    padding: 2.75rem 1.2rem 1.1rem;
    background: linear-gradient(
      transparent,
      rgb(9 20 14 / 0.55) 45%,
      rgb(9 20 14 / 0.95)
    );
    text-shadow: 0 1px 2px rgb(9 20 14 / 0.5);
    color: var(--cream);
    font-size: var(--step--1);
    font-style: italic;
    font-family: var(--display);
    transition: opacity 0.3s var(--ease);
  }
  .inc__caption.is-fading { opacity: 0; }

  /* --- list --- */
  .inc__title { font-size: var(--step-4); margin-bottom: 1rem; }
  .inc__lede { color: var(--muted); max-width: 40ch; margin-bottom: 2.25rem; }

  .inc__list { list-style: none; margin: 0; padding: 0; }
  .inc__item { position: relative; border-top: 1px solid var(--rule-soft); }
  .inc__item:last-of-type { border-bottom: 1px solid var(--rule-soft); }

  .inc__row {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 2vw, 1.75rem);
    width: 100%;
    padding: 1.3rem 0;
    background: none;
    border: 0;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
    transition: padding-left 0.45s var(--ease-out);
  }
  .inc__item.is-active .inc__row { padding-left: 0.85rem; }


  .inc__text { display: grid; gap: 0.15rem; flex: 1; min-width: 0; }
  .inc__text strong {
    font-family: var(--display);
    font-size: var(--step-1);
    font-weight: 500;
    transition: color 0.4s var(--ease);
  }
  .inc__item.is-active .inc__text strong { color: var(--moss); }
  .inc__text > span { color: var(--muted); font-size: var(--step--1); }

  /* small thumb for phones, where there is no hover and no side panel */
  .inc__thumb {
    flex: none;
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 4px;
    overflow: hidden;
    display: none;
    box-shadow: 0 0 0 1px var(--rule-soft);
  }
  .inc__thumb img { width: 100%; height: 100%; object-fit: cover; }

  .inc__underline {
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 1px;
    width: 100%;
    background: var(--moss);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.55s var(--ease-out);
  }
  .inc__item.is-active .inc__underline { transform: scaleX(1); }

  .inc__hint {
    margin: 1.4rem 0 0;
    font-size: 0.7rem;
    letter-spacing: 0.02em;
    color: color-mix(in oklab, var(--ink) 62%, transparent);
  }

  @media (max-width: 860px) {
    .inc__grid { grid-template-columns: 1fr; }
    .inc__media { position: static; }
    .inc__stack { aspect-ratio: 16 / 10; }
    .inc__thumb { display: block; }
    .inc__hint { display: none; }
  }

  /* --- phone ---
     A column of title / description / thumbnail rows is the feature list
     every template ships with, and it read as one: six near-identical
     stripes with the photographs shrunk to punctuation. These are objects
     on a table, so they are laid out as objects — two to a row, photograph
     first and big enough to recognise. */
  @media (max-width: 560px) {
    .inc__stack { aspect-ratio: 4 / 3; }

    .inc__list {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1.6rem 0.9rem;
    }
    .inc__item, .inc__item:last-of-type { border: 0; }
    .inc__underline { display: none; }

    .inc__row {
      display: grid;
      gap: 0.5rem;
      padding: 0;
      text-align: left;
    }
    .inc__item.is-active .inc__row { padding-left: 0; }

    .inc__thumb {
      display: block;
      order: -1;
      width: 100%;
      height: auto;
      aspect-ratio: 1;
      border-radius: 5px;
    }
    .inc__thumb img { width: 100%; height: 100%; object-fit: cover; }

    .inc__text { gap: 0.2rem; }
    .inc__text strong { font-size: var(--step-0); line-height: 1.25; }
    .inc__text > span { font-size: 0.8rem; line-height: 1.45; }
  }

  /* touch devices wider than a phone keep the row, with a usable thumbnail */
  @media (min-width: 561px) and (pointer: coarse) {
    .inc__thumb { width: 4.6rem; height: 4.6rem; border-radius: 4px; }
    .inc__row { gap: 1rem; padding-block: 1.05rem; }
  }
  @media (hover: none) {
    .inc__hint { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .inc__photo { transition: opacity 0.2s linear; transform: none; }
    .inc__photo.is-shown { transform: none; }
  }

  /* Micro-labels: readable in the hand, not just on a desktop. */
  @media (max-width: 560px), (pointer: coarse) {
    .inc__hint { font-size: 0.78rem; letter-spacing: 0.01em; }
  }
</style>

<script>
  const section = document.querySelector('[data-included]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-item]')];
  const layers = [...document.querySelectorAll<HTMLElement>('[data-layer]')];
  const caption = document.querySelector('[data-caption]') as HTMLElement | null;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let active = -1;

  function setActive(next: number) {
    if (next === active) return;
    active = next;
    items.forEach((el, i) => el.classList.toggle('is-active', i === next));
    layers.forEach((el, i) => el.classList.toggle('is-shown', i === next));
    caption?.classList.toggle('is-fading', next !== -1);
  }

  // desktop: the row you point at drives the picture
  const pointer = window.matchMedia('(hover: hover)');
  items.forEach((el, i) => {
    el.addEventListener('mouseenter', () => { if (pointer.matches) setActive(i); });
    el.querySelector('button')?.addEventListener('focus', () => setActive(i));
    // tapping a row on a touch screen still works
    el.querySelector('button')?.addEventListener('click', () => setActive(i));
  });
  document.querySelector('[data-list]')?.addEventListener('mouseleave', () => {
    if (pointer.matches) setActive(-1);
  });

  // phones: whichever row sits nearest the middle of the screen is the active one
  if (!pointer.matches && items.length) {
    let ticking = false;
    const update = () => {
      const mid = window.innerHeight / 2;
      let best = -1;
      let bestDist = Infinity;
      items.forEach((el, i) => {
        const r = el.getBoundingClientRect();
        if (r.bottom < 0 || r.top > window.innerHeight) return;
        const d = Math.abs(r.top + r.height / 2 - mid);
        if (d < bestDist) { bestDist = d; best = i; }
      });
      setActive(best);
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    update();
  }

</script>
