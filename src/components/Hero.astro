---
import { u } from '../lib/url';
import { hero } from '../data/site';
import { fmtDate, fmtTime, fmtDuration, fmtPrice, availability } from '../lib/format';
import type { WorkshopEvent } from '../data/events';

interface Props { next?: WorkshopEvent }
const { next } = Astro.props;
const avail = next ? availability(next.capacity, next.seats_taken, next.registrations_open) : null;

/**
 * Three facts, set as one line rather than a three-column strip of labels
 * and values. Live numbers from the next workshop where there is one.
 */
const meta = next
  ? [fmtDuration(next.duration_minutes), fmtPrice(next.price_cents), 'опит не е нужен']
  : [hero.facts[0].v, hero.facts[1].v, 'опит не е нужен'];
---

<section class="hero" id="top">
  <div class="hero__media" data-hero-media>
    <video
      class="hero__video"
      poster={u("/media/hero-gora.jpg")}
      autoplay muted loop playsinline
      preload="metadata"
      aria-hidden="true"
      tabindex="-1"
    >
      <source src={u("/media/hero-gora.webm")} type="video/webm" />
      <source src={u("/media/hero-gora.mp4")} type="video/mp4" />
    </video>
    <div class="hero__scrim"></div>
  </div>

  <div class="hero__body wrap">
    <div class="hero__text">
      <h1 class="hero__title">
        <span class="hero__line"><span>{hero.titleLead}</span></span>
        <span class="hero__line hero__line--in"><span class="hero__alive">{hero.titleAccent}</span></span>
      </h1>

      <p class="hero__lede">{hero.lede}</p>

      <div class="hero__actions">
        <a class="btn btn--light" href="#rabotilnitsi">{hero.ctaPrimary}</a>
        <ul class="hero__meta">
          {meta.map((m) => <li>{m}</li>)}
        </ul>
      </div>
    </div>

    <!-- Two of her pieces, hung from wires that run off the top of the
         screen. Each swings at its own rate, so the wall is never still. -->
    <div class="hero__hangs" aria-hidden="true">
      <figure class="hang hang--far" data-hang style="--sway:7.5s; --lean:-1.4deg; --depth:0.35">
        <span class="hang__wire"></span>
        <span class="hang__nail"></span>
        <span class="hang__frame">
          <img src={u(hero.piece2.src)} alt="" width="640" height="800" loading="lazy" decoding="async" />
        </span>
      </figure>

      <figure class="hang hang--near" data-hang style="--sway:9.5s; --lean:1.1deg; --depth:1">
        <span class="hang__wire"></span>
        <span class="hang__nail"></span>
        <span class="hang__frame">
          <img src={u(hero.piece.src)} alt="" width="635" height="640" fetchpriority="low" decoding="async" />
        </span>
        <figcaption class="hang__cap">{hero.piece.caption}</figcaption>
      </figure>
    </div>
  </div>

  {next && avail && (
    <a class="ticker" href={`#${next.slug}`}>
      <span class="ticker__label">Следваща работилница</span>
      <span class="ticker__sep" aria-hidden="true"></span>
      <span class="ticker__main">
        <strong>{next.title}</strong>
        <span>{fmtDate(next.starts_at)}, {fmtTime(next.starts_at)} ч. · {next.city}</span>
      </span>
      <span class={`ticker__seats${avail.scarce ? ' is-scarce' : ''}${avail.full ? ' is-full' : ''}`}>
        {avail.label}
      </span>
      <span class="ticker__arrow" aria-hidden="true">↓</span>
    </a>
  )}

</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    grid-template-rows: 1fr auto;
    align-items: end;
    isolation: isolate;
    background: var(--forest-dp);
    color: var(--cream);
    overflow: hidden;
  }

  .hero__media { position: absolute; inset: -8% 0 0; z-index: -1; will-change: transform; }
  .hero__video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.05);
  }
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, rgb(9 20 14 / 0.9) 0%, rgb(9 20 14 / 0.62) 42%, rgb(9 20 14 / 0.12) 82%),
      linear-gradient(to top, rgb(9 20 14 / 0.92) 0%, rgb(9 20 14 / 0.55) 40%, rgb(9 20 14 / 0.28) 72%, rgb(9 20 14 / 0.72) 100%),
      radial-gradient(120% 80% at 46% 46%, transparent 28%, rgb(9 20 14 / 0.5) 100%);
  }

  /* Twelve columns, and the wall of hung pieces deliberately starts inside
     the text's last column — the two interlock instead of sitting in two
     tidy halves, which is the arrangement every template hero has. */
  .hero__body {
    padding-block: 9rem 2.5rem;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    align-items: center;
    width: min(100% - var(--gutter) * 2, 84rem);
  }
  .hero__text { grid-column: 1 / 8; grid-row: 1; z-index: 2; display: grid; justify-items: start; }

  /* --- the headline --- */
  .hero__title {
    font-size: clamp(3.4rem, 9.2vw, 7.4rem);
    line-height: 0.9;
    letter-spacing: -0.035em;
    margin: 0 0 1.5rem;
  }
  .hero__line { display: block; overflow: hidden; padding-block: 0.06em; }
  .hero__line > span {
    display: block;
    transform: translateY(105%);
    animation: maskUp 1.15s var(--ease-out) forwards;
  }
  .hero__line:nth-child(1) > span { animation-delay: 0.2s; }
  .hero__line:nth-child(2) > span { animation-delay: 0.34s; }
  /* the second line steps in, so the block is not a centred stack */
  .hero__line--in { margin-inline-start: 1.1em; }

  /* The word "живо" is filled with a photograph of real moss — and the moss
     drifts, very slowly, so the word is never quite the same twice. */
  .hero__alive {
    background-image:
      linear-gradient(rgb(214 236 190 / 0.42), rgb(214 236 190 / 0.42)),
      url('/media/texture/muh-edro.webp');
    background-size: 128% auto;
    background-position: 50% 58%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    filter: saturate(1.25) contrast(1.12) brightness(1.18);
    padding-inline-end: 0.08em;
    animation: mossDrift 38s linear infinite alternate;
  }
  @supports not ((background-clip: text) or (-webkit-background-clip: text)) {
    .hero__alive { color: var(--lichen); -webkit-text-fill-color: currentColor; }
  }

  .hero__lede {
    font-size: var(--step-0);
    line-height: 1.6;
    max-width: 34ch;
    color: color-mix(in oklab, var(--cream) 82%, transparent);
    margin: 0 0 2.1rem;
    opacity: 0;
    animation: riseIn 1s var(--ease-out) 0.6s forwards;
  }

  /* one call to action, and the three facts as a line rather than a strip */
  .hero__actions {
    display: flex;
    align-items: center;
    gap: 1.4rem 1.8rem;
    flex-wrap: wrap;
    opacity: 0;
    animation: riseIn 1s var(--ease-out) 0.72s forwards;
  }
  .hero__meta {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: var(--step--1);
    color: color-mix(in oklab, var(--cream) 72%, transparent);
  }
  .hero__meta li + li::before {
    content: "·";
    margin-inline-end: 0.75rem;
    color: color-mix(in oklab, var(--cream) 45%, transparent);
  }

  /* --- the hung pieces --- */
  .hero__hangs {
    grid-column: 6 / 13;
    grid-row: 1;
    z-index: 1;
    position: relative;
    align-self: stretch;
    min-height: 34rem;
    pointer-events: none;
  }

  .hang {
    position: absolute;
    margin: 0;
    /* set per piece, read by the parallax script */
    --px: 0px;
    --py: 0px;
    transform: translate3d(var(--px), var(--py), 0);
    transition: transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }
  /* the wire runs up and off the top of the section — the rail is out of frame */
  .hang__wire {
    position: absolute;
    left: 50%;
    bottom: 100%;
    width: 1px;
    height: 100vh;
    background: linear-gradient(to bottom, transparent, color-mix(in oklab, var(--cream) 34%, transparent));
  }
  .hang__nail {
    position: absolute;
    left: 50%;
    bottom: calc(100% - 3px);
    width: 7px;
    height: 7px;
    margin-left: -3.5px;
    border-radius: 50%;
    background: var(--brass);
    box-shadow: 0 1px 3px rgb(0 0 0 / 0.5);
  }
  .hang__frame {
    display: block;
    padding: 0.7rem;
    background: var(--paper);
    border-radius: 2px;
    box-shadow:
      0 2px 4px rgb(0 0 0 / 0.28),
      0 26px 60px -18px rgb(0 0 0 / 0.75);
    transform-origin: 50% -18%;
    animation: sway var(--sway, 9s) ease-in-out infinite alternate;
  }
  .hang__frame img { display: block; width: 100%; height: auto; border-radius: 1px; }
  .hang__cap {
    margin-top: 0.7rem;
    text-align: center;
    font-family: var(--display);
    font-style: italic;
    font-size: var(--step--1);
    color: color-mix(in oklab, var(--cream) 70%, transparent);
  }

  /* near: large, hangs low, carries the caption */
  .hang--near {
    width: min(60%, 21rem);
    right: 2%;
    top: 16%;
    opacity: 0;
    animation: hangIn 1.2s var(--ease-out) 0.5s forwards;
  }
  /* far: smaller, higher, well back in the shade — depth without a third
     image, and dark enough that the headline can run across it */
  .hang--far {
    width: min(32%, 11rem);
    left: -3%;
    top: -8%;
    filter: brightness(0.5) saturate(0.72) blur(1.2px);
    opacity: 0;
    animation: hangIn 1.2s var(--ease-out) 0.72s forwards;
  }

  .ticker {
    position: relative;
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 2vw, 1.8rem);
    padding: 1.1rem var(--gutter);
    background: color-mix(in oklab, var(--cream) 12%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-top: 1px solid color-mix(in oklab, var(--cream) 20%, transparent);
    text-decoration: none;
    font-size: var(--step--1);
    opacity: 0;
    animation: riseIn 0.9s var(--ease-out) 0.9s forwards;
    transition: background-color 0.4s var(--ease);
  }
  .ticker:hover { background: color-mix(in oklab, var(--cream) 20%, transparent); }
  .ticker__label {
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--lichen);
    flex: none;
  }
  .ticker__sep { width: 1px; height: 1.6rem; background: color-mix(in oklab, var(--cream) 25%, transparent); flex: none; }
  .ticker__main { display: flex; align-items: baseline; gap: 0.7rem; flex-wrap: wrap; min-width: 0; }
  .ticker__main strong { font-family: var(--display); font-size: 1.15rem; font-weight: 500; }
  .ticker__main span { color: color-mix(in oklab, var(--cream) 78%, transparent); }
  .ticker__seats {
    margin-inline-start: auto;
    padding: 0.35em 0.9em;
    border-radius: 100px;
    border: 1px solid color-mix(in oklab, var(--cream) 30%, transparent);
    white-space: nowrap;
    flex: none;
  }
  .ticker__seats.is-scarce { border-color: var(--clay); background: color-mix(in oklab, var(--clay) 26%, transparent); }
  .ticker__seats.is-full { opacity: 0.6; }
  .ticker__arrow { flex: none; transition: transform 0.4s var(--ease-out); }
  .ticker:hover .ticker__arrow { transform: translateY(3px); }

  @keyframes maskUp { to { transform: none; } }
  @keyframes riseIn { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  @keyframes hangIn {
    from { opacity: 0; transform: translate3d(var(--px), calc(var(--py) - 26px), 0) rotate(var(--lean, 0deg)); }
    to   { opacity: 1; transform: translate3d(var(--px), var(--py), 0); }
  }
  @keyframes sway {
    from { transform: rotate(calc(var(--lean, 1deg) * -1)); }
    to   { transform: rotate(var(--lean, 1deg)); }
  }
  /* 38 seconds end to end: you never catch it moving, only notice it has */
  @keyframes mossDrift {
    from { background-position: 44% 52%; }
    to   { background-position: 58% 66%; }
  }

  /* --- replaying the entrance when the hero is scrolled back to --- */
  .hero.is-resetting .hero__line > span,
  .hero.is-resetting .hero__lede,
  .hero.is-resetting .hero__actions,
  .hero.is-resetting .ticker,
  .hero.is-resetting .hang { animation: none; opacity: 0; }
  .hero.is-resetting .hero__line > span { transform: translateY(105%); opacity: 1; }

  /* --- tablet --- */
  @media (max-width: 1080px) {
    .hero__text { grid-column: 1 / 9; }
    .hero__hangs { grid-column: 8 / 13; min-height: 26rem; }
    .hang--near { width: min(78%, 16rem); top: 20%; }
    .hang--far { width: min(46%, 10rem); top: -6%; }
  }

  /* --- phone ---
     The pieces used to be hidden here, which left the plainest possible
     stack: headline, paragraph, two buttons, a strip of numbers. One piece
     stays, hung from the top corner across from the headline, so the first
     thing on the screen is still something she made. */
  @media (max-width: 860px) {
    .hero__body {
      padding-block: 7.5rem 2rem;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      align-items: start;
      row-gap: 0;
    }
    .hero__text { grid-column: 1 / 7; grid-row: 2; }
    /* In normal flow here, not absolute: an absolutely positioned frame
       overflows whatever height the container is given, and the headline
       then runs across the bright edge of the photograph — the one overlap
       that does not read. In flow, the frame sets the height itself. */
    .hero__hangs {
      grid-column: 3 / 7;
      grid-row: 1;
      min-height: 0;
      height: auto;
      display: flex;
      justify-content: flex-end;
      margin-bottom: 2rem;
    }
    .hang--near {
      position: relative;
      width: min(100%, 14rem);
      right: auto;
      top: auto;
    }
    .hang--far { display: none; }
    .hang__cap { display: none; }
    .hang__frame { padding: 0.45rem; }

    .hero__title { font-size: clamp(3rem, 13.5vw, 4.6rem); }
    .hero__line--in { margin-inline-start: 0.6em; }
    .hero__lede { max-width: 30ch; margin-bottom: 1.7rem; }
    .hero__actions { gap: 1rem 1.2rem; }
    .hero__actions .btn { width: 100%; justify-content: center; }
    .hero__meta { flex-wrap: wrap; gap: 0.5rem; }

    /* the ticker stacks rather than squeezing four things onto one line */
    .ticker { flex-wrap: wrap; gap: 0.6rem 1rem; }
    .ticker__sep { display: none; }
    .ticker__seats { margin-inline-start: 0; }
    .ticker__arrow { margin-inline-start: auto; }
  }

  @media (max-width: 420px) {
    .hero__meta li + li::before { margin-inline-end: 0.5rem; }
    .hero__meta { gap: 0.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__line > span { transform: none; animation: none; }
    .hero__lede, .hero__actions, .ticker, .hang { opacity: 1; animation: none; }
    .hang__frame { animation: none; }
    .hero__alive { animation: none; }
    .hang { transition: none; }
  }
</style>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  const media = document.querySelector('[data-hero-media]') as HTMLElement | null;
  const hangs = [...document.querySelectorAll<HTMLElement>('[data-hang]')];
  const video = document.querySelector('.hero__video') as HTMLVideoElement | null;

  /**
   * The wall reacts to two things: the page scrolling, and the pointer
   * moving across it. Each hung piece has a --depth, and everything is
   * scaled by it, so the near piece travels further than the far one and the
   * composition has somewhere to move rather than sitting flat.
   */
  if (!reduce.matches) {
    const heroEl = document.querySelector('.hero') as HTMLElement | null;
    let scrollY = 0;
    let px = 0;
    let py = 0;
    let ticking = false;

    const apply = () => {
      if (media) media.style.transform = `translate3d(0, ${scrollY * 0.22}px, 0)`;
      for (const hang of hangs) {
        const d = Number(getComputedStyle(hang).getPropertyValue('--depth')) || 0.5;
        hang.style.setProperty('--px', `${px * 16 * d}px`);
        hang.style.setProperty('--py', `${py * 12 * d + scrollY * -0.06 * d}px`);
      }
      ticking = false;
    };
    const schedule = () => { if (!ticking) { ticking = true; requestAnimationFrame(apply); } };

    window.addEventListener('scroll', () => {
      scrollY = Math.min(window.scrollY, window.innerHeight);
      schedule();
    }, { passive: true });

    // Pointer only: on a touch screen there is no hover to follow, and the
    // scroll parallax already carries the movement there.
    if (window.matchMedia('(hover: hover) and (pointer: fine)').matches && heroEl) {
      heroEl.addEventListener('pointermove', (e) => {
        const r = heroEl.getBoundingClientRect();
        px = (e.clientX - r.left) / r.width - 0.5;
        py = (e.clientY - r.top) / r.height - 0.5;
        schedule();
      }, { passive: true });
      heroEl.addEventListener('pointerleave', () => { px = 0; py = 0; schedule(); }, { passive: true });
    }

    apply();
  }

  // Replay the entrance when the hero comes back into view, so the animation
  // is not a one-shot you have to reload the page to see again.
  const hero = document.querySelector('.hero') as HTMLElement | null;
  if (hero && !reduce.matches) {
    let wasOut = false;
    const io = new IntersectionObserver(
      ([entry]) => {
        if (entry.intersectionRatio === 0) {
          wasOut = true;
        } else if (wasOut && entry.intersectionRatio > 0.15) {
          wasOut = false;
          hero.classList.add('is-resetting');
          void hero.offsetWidth; // flush the reset before re-arming
          hero.classList.remove('is-resetting');
        }
      },
      { threshold: [0, 0.15] }
    );
    io.observe(hero);
  }

  // Don't burn battery decoding video that nobody can see.
  if (video) {
    if (reduce.matches) { video.pause(); }
    else {
      const io = new IntersectionObserver(([entry]) => {
        if (entry.isIntersecting) video.play().catch(() => {});
        else video.pause();
      }, { threshold: 0.01 });
      io.observe(video);
    }
  }
</script>
