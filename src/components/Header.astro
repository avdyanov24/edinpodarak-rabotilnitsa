---
import { u } from '../lib/url';
import { brand } from '../data/site';

interface Props {
  /** True only on pages with a dark hero behind the bar (the home page). */
  overlay?: boolean;
}
const { overlay = false } = Astro.props;

const nav = [
  { href: '#rabotilnitsi', label: 'Работилници' },
  { href: '#kak-protica', label: 'Как протича' },
  { href: '#galeriya', label: 'Галерия' },
  { href: '#vaprosi', label: 'Въпроси' },
];
---

<header class={`hdr${overlay ? '' : ' is-solid'}`} data-header data-overlay={overlay ? '1' : null}>
  <!-- How far down a page that has no other landmarks you are. One long
       scroll with no chapters gives no sense of length; a hairline does. -->
  <span class="hdr__progress" data-progress aria-hidden="true"></span>
  <div class="hdr__inner wrap">
    <a class="hdr__brand" href="#top" aria-label={`${brand.name} · ${brand.owner}`}>
      <img src={u("/media/logo-djeilya.png")} alt="" width="40" height="40" />
      <span class="hdr__brandText">
        <strong>Работилница</strong>
        <small>с Джейля</small>
      </span>
    </a>

    <nav class="hdr__nav" aria-label="Основна навигация">
      {nav.map((item) => (
        <a class="hdr__link" href={item.href}>{item.label}</a>
      ))}
    </nav>

    <a class="btn btn--light hdr__cta" href="#rabotilnitsi">Запиши се</a>

    <button class="hdr__burger" type="button" data-menu-toggle aria-expanded="false" aria-controls="menu">
      <span class="vh">Меню</span>
      <span class="hdr__burgerBars" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>

  <div class="menu" id="menu" data-menu hidden>
    <nav class="menu__nav" aria-label="Мобилна навигация">
      {nav.map((item, i) => (
        <a class="menu__link" href={item.href} style={`--i:${i}`}>
          <span class="menu__num">0{i + 1}</span>{item.label}
        </a>
      ))}
      <a class="menu__link" href="#kontakti" style={`--i:${nav.length}`}>
        <span class="menu__num">0{nav.length + 1}</span>Контакти
      </a>
    </nav>
    <div class="menu__foot">
      <a class="btn btn--light" href="#rabotilnitsi">Запиши се за работилница</a>
      <a class="link" href={`tel:${brand.phone}`}>{brand.phoneDisplay}</a>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto;
    z-index: 900;
    color: var(--cream);
    text-shadow: 0 1px 12px rgb(9 20 14 / 0.55);
    transition: background-color 0.5s var(--ease), backdrop-filter 0.5s var(--ease),
      box-shadow 0.5s var(--ease), color 0.4s var(--ease);
  }
  .hdr::before {
    content: "";
    position: absolute;
    inset: 0 0 -2.5rem;
    background: linear-gradient(rgb(9 20 14 / 0.62), transparent);
    pointer-events: none;
    transition: opacity 0.5s var(--ease);
  }
  .hdr.is-solid::before { opacity: 0; }
  .hdr.is-solid { text-shadow: none; }

  .hdr__progress {
    position: absolute;
    inset: auto 0 0 0;
    height: 2px;
    transform: scaleX(var(--p, 0));
    transform-origin: left;
    background: linear-gradient(90deg, var(--moss), var(--clay));
    opacity: 0;
    transition: opacity 0.5s var(--ease);
    pointer-events: none;
  }
  .hdr.is-solid .hdr__progress { opacity: 1; }
  .hdr__inner {
    position: relative;
    z-index: 2; /* above the open menu, so the close button stays reachable */
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-block: clamp(0.85rem, 1.6vw, 1.35rem);
  }

  .hdr__brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    margin-inline-end: auto;
  }
  .hdr__brand img {
    width: 40px; height: 40px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--cream);
    box-shadow: 0 0 0 1px color-mix(in oklab, currentColor 25%, transparent);
  }
  .hdr__brandText { display: grid; line-height: 1.12; }
  .hdr__brandText strong {
    font-family: var(--display);
    font-weight: 500;
    font-size: 1.12rem;
    letter-spacing: 0.01em;
  }
  .hdr__brandText small {
    font-size: 0.68rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    opacity: 0.72;
  }

  .hdr__nav { display: flex; gap: clamp(1rem, 2.2vw, 2.2rem); }
  .hdr__link {
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 500;
    letter-spacing: 0.02em;
    position: relative;
    padding-block: 0.35rem;
    opacity: 0.86;
    transition: opacity 0.3s var(--ease);
  }
  .hdr__link::after {
    content: "";
    position: absolute;
    left: 0; bottom: 0;
    width: 100%; height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.45s var(--ease-out);
  }
  .hdr__link:hover { opacity: 1; }
  .hdr__link:hover::after { transform: scaleX(1); transform-origin: left; }

  .hdr__cta { padding: 0.72em 1.5em; }

  /* --- scrolled state: cream bar, dark text --- */
  .hdr.is-solid {
    background: color-mix(in oklab, var(--paper) 88%, transparent);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
    color: var(--ink);
    box-shadow: 0 1px 0 color-mix(in oklab, var(--ink) 10%, transparent);
  }
  .hdr.is-solid .hdr__cta {
    --btn-bg: var(--forest);
    --btn-fg: var(--cream);
  }

  /* --- burger --- */
  .hdr__burger {
    display: none;
    width: 44px; height: 44px;
    border: 1px solid color-mix(in oklab, currentColor 30%, transparent);
    border-radius: 50%;
    background: none;
    color: inherit;
    cursor: pointer;
    place-items: center;
  }
  .hdr__burgerBars { display: grid; gap: 5px; width: 17px; }
  .hdr__burgerBars i {
    display: block; height: 1.5px; background: currentColor; border-radius: 2px;
    transition: transform 0.4s var(--ease-out), opacity 0.3s var(--ease);
  }
  .hdr.is-open { color: var(--cream); text-shadow: none; }
  .hdr.is-open .hdr__brandText small { opacity: 0.72; }
  .hdr.is-open .hdr__burgerBars i:first-child { transform: translateY(3.25px) rotate(45deg); }
  .hdr.is-open .hdr__burgerBars i:last-child { transform: translateY(-3.25px) rotate(-45deg); }

  /* --- mobile menu --- */
  .menu {
    position: fixed;
    inset: 0;
    /* inset:0 on a fixed element is the layout viewport, which on iOS extends
       behind the browser bars — the button at the bottom ended up under them. */
    height: 100dvh;
    z-index: 1;
    background: var(--forest-dp);
    color: var(--cream);
    padding: 6rem var(--gutter) calc(2.5rem + env(safe-area-inset-bottom));
    display: grid;
    align-content: space-between;
    gap: 2rem;
  }
  .menu[hidden] { display: none; }
  .menu__nav { display: grid; }
  .menu__link {
    font-family: var(--display);
    font-size: clamp(1.9rem, 8vw, 2.8rem);
    text-decoration: none;
    padding-block: 0.5rem;
    border-bottom: 1px solid color-mix(in oklab, var(--cream) 14%, transparent);
    display: flex;
    align-items: baseline;
    gap: 1rem;
    opacity: 0;
    transform: translateY(14px);
    animation: menuIn 0.6s var(--ease-out) forwards;
    animation-delay: calc(var(--i) * 60ms + 80ms);
  }
  .menu__num {
    font-family: var(--sans);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    color: var(--lichen);
  }
  @keyframes menuIn { to { opacity: 1; transform: none; } }
  .menu__foot { display: grid; gap: 1.2rem; justify-items: start; }

  @media (max-width: 880px) {
    .hdr__nav, .hdr__cta { display: none; }
    .hdr__burger { display: grid; }
  }
  @media (prefers-reduced-motion: reduce) {
    .menu__link { opacity: 1; transform: none; animation: none; }
  }

  /* Micro-labels: readable in the hand, not just on a desktop. */
  @media (max-width: 560px), (pointer: coarse) {
    .hdr__brandText small { font-size: 0.76rem; letter-spacing: 0.13em; }
    .menu__foot .link { display: inline-block; padding-block: 0.68rem; }
    .menu__num { font-size: 0.78rem; letter-spacing: 0.12em; }
  }
</style>

<script>
  const header = document.querySelector('[data-header]');
  const toggle = document.querySelector('[data-menu-toggle]');
  const menu = document.querySelector('[data-menu]');

  // On overlay pages the bar is transparent until the hero scrolls away.
  // Everywhere else it starts solid and stays solid.
  if (header instanceof HTMLElement && header.dataset.overlay === '1') {
    const onScroll = () => header.classList.toggle('is-solid', window.scrollY > 40);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  const progress = document.querySelector<HTMLElement>('[data-progress]');
  if (progress) {
    let queued = false;
    const paint = () => {
      queued = false;
      const room = document.documentElement.scrollHeight - window.innerHeight;
      progress.style.setProperty('--p', room > 0 ? String(Math.min(1, window.scrollY / room)) : '0');
    };
    window.addEventListener('scroll', () => {
      if (!queued) { queued = true; requestAnimationFrame(paint); }
    }, { passive: true });
    window.addEventListener('resize', paint);
    paint();
  }

  /**
   * Locking the page while the menu is open.
   *
   * `body { overflow: hidden }` is ignored by Safari on iOS — the page keeps
   * scrolling behind the menu, and closing it leaves you somewhere else
   * entirely. Pinning the body and restoring the offset afterwards is the
   * only thing that holds on every browser.
   */
  let lockedAt = 0;
  const lockScroll = (on: boolean) => {
    const body = document.body;
    if (on) {
      lockedAt = window.scrollY;
      body.style.position = 'fixed';
      body.style.top = `-${lockedAt}px`;
      body.style.insetInline = '0';
      body.style.width = '100%';
    } else if (body.style.position === 'fixed') {
      body.style.position = '';
      body.style.top = '';
      body.style.insetInline = '';
      body.style.width = '';
      // instant, or the browser animates back up the page
      window.scrollTo({ top: lockedAt, behavior: 'instant' as ScrollBehavior });
    }
  };

  const setOpen = (open: boolean) => {
    header?.classList.toggle('is-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    if (menu) (menu as HTMLElement).hidden = !open;
    lockScroll(open);
  };

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) setOpen(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') setOpen(false);
  });
</script>
