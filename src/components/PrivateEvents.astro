---
import { u } from '../lib/url';
import { privateEvents, brand } from '../data/site';
const subject = encodeURIComponent('Запитване за частна работилница');
---

<section class="grp" id="grupi">
  <div class="grp__media" aria-hidden="true" data-grp-media>
    <img src={u("/media/workshop/rabota-5.webp")} alt="" loading="lazy" decoding="async" width="1400" height="933" />
  </div>

  <div class="grp__body wrap">
    <div class="grp__inner">
      <h2 class="grp__title">{privateEvents.title}</h2>
      <p class="grp__text">{privateEvents.text}</p>


      <div class="grp__actions">
        <a class="btn btn--light" href={`mailto:${brand.email}?subject=${subject}`}>
          {privateEvents.cta}
        </a>
        <a class="btn btn--outline-light" href={`tel:${brand.phone}`}>{brand.phoneDisplay}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .grp {
    position: relative;
    isolation: isolate;
    color: var(--cream);
    display: grid;
    align-items: center;
    min-height: clamp(26rem, 54vw, 36rem);
    overflow: hidden;
  }
  .grp__media { position: absolute; inset: -10% 0; z-index: -1; will-change: transform; }
  .grp__media img { width: 100%; height: 100%; object-fit: cover; }
  .grp__media::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, rgb(9 20 14 / 0.95) 10%, rgb(9 20 14 / 0.78) 46%, rgb(9 20 14 / 0.42));
  }
  .grp__body { padding-block: clamp(4rem, 8vw, 7rem); }
  .grp__inner { max-width: 52ch; }
  .grp .eyebrow { color: var(--lichen); }
  .grp__title { font-size: var(--step-4); margin-bottom: 1.1rem; }
  .grp__text { color: color-mix(in oklab, var(--cream) 86%, transparent); margin-bottom: 2.25rem; font-size: var(--step-1); line-height: 1.6; }


  .grp__actions { display: flex; gap: 0.85rem; flex-wrap: wrap; }

  /* --- phone ---
     On a wide screen the words sit in the quiet left third of the photograph.
     Narrowed to 390px that quiet third is gone and the text lands across the
     middle of the picture. So the picture gets the top of the block to
     itself and the words get a ground of their own underneath. */
  @media (max-width: 700px) {
    .grp {
      display: block;
      min-height: 0;
      background: var(--forest-dp);
    }
    .grp__media {
      position: relative;
      inset: auto;
      z-index: 0;
      aspect-ratio: 5 / 4;
    }
    .grp__media::after {
      /* only enough to seat the photo into the dark below it */
      background: linear-gradient(rgb(9 20 14 / 0) 55%, rgb(9 20 14 / 0.85));
    }
    .grp__body { padding-block: 2rem clamp(3rem, 9vw, 4rem); }
    .grp__title { font-size: var(--step-3); }
    .grp__text { font-size: var(--step-0); margin-bottom: 1.8rem; }
    .grp__actions { display: grid; gap: 0.7rem; }
    .grp__actions .btn { justify-content: center; }
  }
</style>

<script>
  // the photograph drifts a little slower than the copy over it
  const media = document.querySelector('[data-grp-media]') as HTMLElement | null;
  const section = document.querySelector('#grupi');
  if (media && section && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let ticking = false;
    const update = () => {
      const rect = section.getBoundingClientRect();
      const vh = window.innerHeight;
      if (rect.bottom > 0 && rect.top < vh) {
        const p = (vh - rect.top) / (vh + rect.height); // 0 entering, 1 leaving
        media.style.transform = `translate3d(0, ${(p - 0.5) * 7}%, 0)`;
      }
      ticking = false;
    };
    window.addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(update); }
    }, { passive: true });
    update();
  }
</script>
