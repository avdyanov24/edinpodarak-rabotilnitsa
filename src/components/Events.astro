---
import EventCard from './EventCard.astro';
import type { WorkshopEvent } from '../data/events';
import { brand } from '../data/site';

interface Props { events: WorkshopEvent[] }
const { events } = Astro.props;
---

<section class="ev section" id="rabotilnitsi">
  <div class="wrap">
    <header class="ev__head">
      <div>
        <h2 class="ev__title">Избери си вечер</h2>
      </div>
      <p class="ev__lede">
        Местата са малко, защото масата е една. Записваш се тук, плащаш на място
        в деня на работилницата.
      </p>
    </header>

    {events.length > 0 ? (
      <div class="ev__grid" data-count={events.length > 2 ? "many" : String(events.length)}>
        {events.map((event, i) => <EventCard event={event} index={i} />)}
      </div>
    ) : (
      <div class="ev__empty">
        <p class="ev__emptyTitle">В момента няма обявена дата.</p>
        <p>
          Пиши ми в <a class="link" href={brand.instagram}>Instagram</a> или на
          <a class="link" href={`tel:${brand.phone}`}>{brand.phoneDisplay}</a> и ще ти кажа
          кога е следващата.
        </p>
      </div>
    )}

    <p class="ev__foot">
      Не намираш подходяща дата?
      <a class="link" href="#grupi">Направи си частна работилница</a> с приятели или с колегите.
    </p>
  </div>
</section>

<style>
  .ev { background: var(--paper-warm); }
  .ev__head {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 2rem;
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--rule);
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }
  .ev__title { font-size: var(--step-4); }
  .ev__lede { max-width: 34ch; color: var(--muted); margin: 0; }

  .ev__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: clamp(3rem, 5vw, 4.5rem) clamp(2rem, 3.5vw, 3.5rem);
    justify-items: start;
  }

  /* Every photograph on this site was cut out of one of her Facebook posters,
     so none is wider than about 800px and several are barely 400. A card
     column wider than that does not make the picture bigger, it makes it
     blurred — so the card has a ceiling and the column is allowed to be
     wider than the card. */
  .ev__grid > :global(.card) { max-width: 26rem; width: 100%; }

  /* Between a phone and a laptop there is not enough width for the spread —
     it squeezed „Магазин „Джейля“, Гоце Делчев“ onto three lines — and not
     enough content for a full-width card. One card, centred, like a poster. */
  @media (min-width: 761px) and (max-width: 999px) {
    .ev__grid[data-count="1"] { justify-items: center; }
  }

  /* One workshop at a time is her normal case, and auto-fit answers that by
     stretching the single card across the whole page: a 520px photograph
     blown up to 1205, and the date, the place and the price pushed below
     1500px of it. With one card the section becomes a spread instead —
     picture on the left at a size it can actually carry, everything you need
     to decide sitting beside it, both on the first screen. */
  @media (min-width: 1000px) {
    .ev__grid[data-count="1"] { grid-template-columns: 1fr; }
    .ev__grid[data-count="1"] > :global(.card) {
      max-width: none;
      grid-template-columns: minmax(0, 26rem) minmax(0, 1fr);
      gap: clamp(2.5rem, 5vw, 4.5rem);
      align-items: center;
    }
    /* One card carrying a whole section can hold a larger voice than one of
       three in a row; at the grid's size it read like a caption. */
    .ev__grid[data-count="1"] :global(.card__title) { font-size: var(--step-3); }
    .ev__grid[data-count="1"] :global(.card__meta) { font-size: var(--step-0); }
    .ev__grid[data-count="1"] :global(.card__meta dt) { font-size: 0.78rem; width: 4.4rem; }
    .ev__grid[data-count="1"] :global(.card__summary) {
      font-size: var(--step-1);
      max-width: 34ch;
    }
    .ev__grid[data-count="1"] :global(.card__plaque) { gap: 1.15rem; }
  }

  .ev__empty {
    text-align: center;
    padding: clamp(3rem, 8vw, 6rem) 1rem;
    border: 1px dashed var(--rule);
    border-radius: 10px;
  }
  .ev__emptyTitle { font-family: var(--display); font-size: var(--step-2); margin-bottom: 0.4rem; }

  .ev__foot {
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
    text-align: center;
    color: var(--muted);
  }
  .ev__foot .link { color: var(--moss); font-weight: 600; }

  @media (max-width: 760px) {
    .ev__head { grid-template-columns: 1fr; align-items: start; }
  }
</style>
