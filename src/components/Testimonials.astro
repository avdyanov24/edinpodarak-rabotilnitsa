---
import { testimonials } from '../data/site';
import type { Testimonial } from '../lib/content';

interface Props { items?: Testimonial[] }
const { items = testimonials.items } = Astro.props;

// Never render an empty wall of quotes: see the note in src/data/site.ts.
if (items.length === 0) return new Response(null, { status: 204 });
---

<section class="tm section">
  <div class="wrap">
    <header class="tm__head">
      <h2 class="tm__title">{testimonials.title}</h2>
    </header>

    <ul class="tm__list">
      {items.map((t, i) => (
        <li class="tm__item" data-reveal style={`--reveal-delay:${i * 120}ms`}>
          <figure class="tm__fig">
            <span class="tm__sprig" aria-hidden="true">
              <svg viewBox="0 0 40 12" width="40" height="12" fill="none" aria-hidden="true">
                <circle cx="6" cy="6" r="3.4" fill="currentColor" opacity="0.9" />
                <circle cx="20" cy="6" r="2.2" fill="currentColor" opacity="0.6" />
                <circle cx="33" cy="6" r="1.4" fill="currentColor" opacity="0.35" />
              </svg>
            </span>

            <blockquote class="tm__quote">
              <p>„{t.quote}“</p>
            </blockquote>

            <figcaption class="tm__by">
              <span class="tm__mark" aria-hidden="true">{t.name.charAt(0)}</span>
              <span class="tm__who">
                <span class="tm__name">{t.name}</span>
                <span class="tm__detail">{t.detail}</span>
              </span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>

    <!-- A real position indicator for the swipe rail. The three dots inside
         each card look exactly like one and never move, which on a phone
         reads as „you are on the first of three“ on every card. -->
    <div class="tm__dots" data-tm-dots aria-hidden="true">
      {items.map(() => <span class="tm__dot"></span>)}
    </div>
  </div>
</section>

<style>
  .tm { background: var(--paper); }
  .tm__head { text-align: center; margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .tm__title { font-size: var(--step-3); }

  .tm__list {
    list-style: none;
    margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17.5rem), 1fr));
    gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .tm__item { display: grid; }
  .tm__fig {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    height: 100%;
    padding: clamp(1.9rem, 3vw, 2.6rem);
    background: var(--paper-warm);
    border: 1px solid var(--rule-soft);
    border-radius: 5px;
    transition: transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out),
      border-color 0.4s var(--ease);
  }
  .tm__item:hover .tm__fig {
    transform: translateY(-4px);
    border-color: color-mix(in oklab, var(--moss) 35%, transparent);
    box-shadow: 0 18px 34px -24px rgb(18 33 26 / 0.55);
  }

  /* three moss dots instead of a giant quote glyph sitting in the text */
  .tm__sprig { color: var(--moss-lt); line-height: 0; }

  .tm__quote { margin: 0; }
  .tm__quote p {
    margin: 0;
    font-family: var(--display);
    font-size: var(--step-1);
    line-height: 1.5;
    text-wrap: pretty;
  }

  .tm__by {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-top: auto;
    padding-top: 1.2rem;
    border-top: 1px solid var(--rule-soft);
    /* Reserved for two lines of „беше на…“, so a longer one does not lift
       that card's rule above its neighbours'. */
    min-height: 5.2rem;
  }
  .tm__mark {
    flex: none;
    width: 2.4rem;
    height: 2.4rem;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: color-mix(in oklab, var(--moss) 16%, transparent);
    color: var(--moss);
    font-family: var(--display);
    font-size: 1.05rem;
    line-height: 1;
  }
  /* Two lines' worth reserved whether the detail needs them or not, so the
     rule above the names lands at the same height on all three cards. */
  .tm__who { display: grid; gap: 0.1rem; min-width: 0; align-content: center; min-height: 2.9em; }
  .tm__name { font-weight: 700; font-size: var(--step--1); letter-spacing: 0.03em; }
  .tm__detail {
    font-size: var(--step--1);
    color: var(--muted);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .tm__dots {
    display: none;
    justify-content: center;
    gap: 0.45rem;
    margin-top: 1.1rem;
  }
  .tm__dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: color-mix(in oklab, var(--ink) 18%, transparent);
    transition: background-color 0.3s var(--ease), transform 0.3s var(--ease-out);
  }
  .tm__dot.is-on { background: var(--moss); transform: scale(1.25); }

  @media (prefers-reduced-motion: reduce) {
    .tm__item:hover .tm__fig { transform: none; }
    .tm__dot { transition: none; }
  }

  /* --- phone ---
     Three cards stacked is the desktop grid with the columns knocked over:
     1,163px of scrolling to read three sentences. Side by side instead, one
     to a screen, with the next one peeking so it is obvious they swipe. */
  @media (max-width: 780px) {
    .tm__list {
      grid-auto-flow: column;
      grid-auto-columns: 82%;
      gap: 0.85rem;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      padding-bottom: 0.4rem;
      scrollbar-width: none;
    }
    .tm__list::-webkit-scrollbar { display: none; }
    .tm__item { scroll-snap-align: start; height: 100%; }

    /* The cards no longer fade in on their own: in a rail that means a card
       re-fading every time it is swiped back to, which reads as a glitch
       rather than a flourish. The section still arrives as a whole. */
    :global(html.js) .tm__item[data-reveal] { opacity: 1; transform: none; }

    /* one indicator for the rail, not one per card */
    .tm__sprig { display: none; }
    .tm__dots { display: flex; }
  }
</style>

<script>
  // Which card the rail has settled on. Cheap: no library, no autoplay, and
  // it does nothing at all on a desktop where the rail is a grid.
  const rail = document.querySelector<HTMLElement>('.tm__list');
  const dots = [...document.querySelectorAll<HTMLElement>('[data-tm-dots] .tm__dot')];
  if (rail && dots.length) {
    let queued = false;
    const sync = () => {
      queued = false;
      const cards = [...rail.children] as HTMLElement[];
      const mid = rail.scrollLeft + rail.clientWidth / 2;
      let best = 0;
      let bestDist = Infinity;
      cards.forEach((c, i) => {
        const d = Math.abs(c.offsetLeft + c.offsetWidth / 2 - mid);
        if (d < bestDist) { bestDist = d; best = i; }
      });
      dots.forEach((d, i) => d.classList.toggle('is-on', i === best));
    };
    rail.addEventListener('scroll', () => {
      if (!queued) { queued = true; requestAnimationFrame(sync); }
    }, { passive: true });
    sync();
  }
</script>
